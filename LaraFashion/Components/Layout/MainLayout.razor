@inherits LayoutComponentBase
@using LaraFashion.Components.Cart
@using LaraFashion.Components.Chat
@using LaraFashion.Components.Orders
@using LaraFashion.Services
@implements IDisposable
@inject NavigationManager Navigation
@inject StoreChatSettingsService ChatSettingsService
@inject ILogger<MainLayout> Logger

<CartPersistence />

<div class="main-layout">

    <header class="store-header">

        <div class="logo-container">

            <img src="images/logo.png"
                 alt="LaraFashion Logo"
                 class="store-logo" />

            <div class="store-title">
                LaraFashion
            </div>

        </div>

        <div style="display:flex; gap:15px; align-items:center;" class="store-actions">

            <CartButton />

            @if (showMyOrders)
            {
                <MyOrdersButton @key="myOrdersModeKey" IsSandbox="isSandbox" />
            }

            <a class="whatsapp-button" href="https://wa.me/972536208730" target="_blank">
                WhatsApp
            </a>

            <a class="instagram-button" href="https://www.instagram.com/lara.fashion94?igsh=MXY2bXBkeDhtY2ZvYg==" target="_blank" rel="noopener noreferrer">
                Instagram
            </a>

        </div>

    </header>

    <main class="main-content">
        @Body
    </main>

</div>

@if (showChat)
{
    <StoreChatWidget Mode="chatMode" />
}

@code {
    private bool showChat;
    private bool showMyOrders;
    private bool isSandbox;
    private string myOrdersModeKey = "customer";
    private StoreChatMode chatMode = StoreChatMode.Customer;
    private long navigationVersion;
    private bool disposed;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await UpdateChatVisibilityAsync(Navigation.Uri);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        _ = InvokeAsync(async () =>
        {
            await UpdateChatVisibilityAsync(args.Location);
            if (!disposed)
                StateHasChanged();
        });
    }

    private async Task UpdateChatVisibilityAsync(string location)
    {
        var version = Interlocked.Increment(ref navigationVersion);
        var path = new Uri(location, UriKind.Absolute).AbsolutePath.TrimEnd('/');
        if (string.IsNullOrEmpty(path))
            path = "/";

        var isSandbox = path.Equals("/admin/sandbox", StringComparison.OrdinalIgnoreCase);
        var isAdminPage = path.Equals("/admin", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("/admin/", StringComparison.OrdinalIgnoreCase);

        this.isSandbox = isSandbox;
        showMyOrders = !isAdminPage || isSandbox;
        myOrdersModeKey = isSandbox ? "sandbox" : "customer";

        if (isSandbox)
        {
            chatMode = StoreChatMode.Sandbox;
            showChat = true;
            return;
        }

        chatMode = StoreChatMode.Customer;
        if (isAdminPage)
        {
            showChat = false;
            return;
        }

        var customerChatEnabled = false;
        try
        {
            customerChatEnabled = await ChatSettingsService.GetCustomerChatEnabledAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not read the customer chat visibility setting; using the safe disabled default.");
        }

        if (!disposed && version == navigationVersion)
            showChat = customerChatEnabled;
    }

    public void Dispose()
    {
        disposed = true;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
