@using LaraFashion.Models
@using LaraFashion.Models.Enums

<div class="product-card">

    <div class="product-image-container">

        <img src="@Product.ImageUrl"
             class="product-image" />

        @if (Product.DiscountType != LaraFashion.Models.Enums.DiscountType.None)
        {
            <div class="discount-badge">

                @if (Product.DiscountType == LaraFashion.Models.Enums.DiscountType.Percent)
                {
                    <span>
                        -@Product.DiscountValue%
                    </span>
                }
                else
                {
                    <span>
                        Sale
                    </span>
                }

            </div>
        }

    </div>

    <div class="product-content">

        <div class="product-name">
            @Product.Name
        </div>

        @if (Product.ProductCategories.Any(x => x.Category.IsActive))
        {
            <div class="product-category-list">
                @foreach (var pc in Product.ProductCategories.Where(x => x.Category.IsActive))
                {
                    <span class="product-category-badge">@pc.Category.Name</span>
                }
            </div>
        }

        <div class="product-price-container">

            @if (Product.DiscountType != LaraFashion.Models.Enums.DiscountType.None)
            {
                <div class="old-price">
                    ₪@Product.OriginalPrice
                </div>
            }

            <div class="final-price">
                ₪@Product.FinalPrice
            </div>

        </div>

        @if (Product.ProductDiscounts.Any(x => x.Discount.IsActive))
        {
            <div class="product-card-offers">
                @foreach (var pd in Product.ProductDiscounts.Where(x => x.Discount.IsActive))
                {
                    <div>@GetDiscountText(pd.Discount)</div>
                }
            </div>
        }

        @if (Product.Sizes.Any(s => s.Quantity > 0))
        {
            <div class="product-available-sizes" dir="rtl">
                <span class="available-sizes-label">المقاسات المتاحة:</span>
                <div class="available-sizes-list">
                    @foreach (var size in Product.Sizes.Where(s => s.Quantity > 0).Select(s => s.SizeName).Distinct())
                    {
                        <span class="available-size-chip">@size</span>
                    }
                </div>
            </div>
        }

    </div>

</div>

@code {

    [Parameter]
    public Product Product { get; set; } = new();

    private string GetDiscountText(Discount discount)
    {
        return discount.RuleType switch
        {
            DiscountRuleType.ProductDirect =>
                discount.ValueType == DiscountValueType.Percent
                    ? $"خصم مباشر {discount.Value}%"
                    : $"خصم مباشر ₪{discount.Value}",

            DiscountRuleType.QuantityBased =>
                discount.ValueType == DiscountValueType.Percent
                    ? $"اشترِ {discount.MinimumQuantity} قطع أو أكثر واحصل على خصم {discount.Value}%"
                    : $"اشترِ {discount.MinimumQuantity} قطع أو أكثر واحصل على خصم ₪{discount.Value}",

            DiscountRuleType.AmountBased =>
                discount.ValueType == DiscountValueType.Percent
                    ? $"عند الشراء بقيمة ₪{discount.MinimumAmount} أو أكثر احصل على خصم {discount.Value}%"
                    : $"عند الشراء بقيمة ₪{discount.MinimumAmount} أو أكثر احصل على خصم ₪{discount.Value}",

            DiscountRuleType.BundleFixedPrice =>
    $"اشترِ {discount.MinimumQuantity} قطع من هذه المجموعة بسعر ₪{discount.BundleFixedTotalPrice} — يتم حساب التخفيض في السلة",

            _ => discount.Name
        };
    }

}