@using LaraFashion.Components.Modals
@using LaraFashion.Models
@using LaraFashion.Models.Enums

@page "/cart"
@implements IDisposable

@inject LaraFashion.Services.CartService CartService
@inject LaraFashion.Services.OrderService OrderService
@inject LaraFashion.Services.ProductService ProductService
@inject LaraFashion.Services.AdminAuthService AdminAuthService
@inject LaraFashion.Services.BrowserStorageService BrowserStorageService

@inject NavigationManager Navigation
@inject IJSRuntime JS

<h1 class="cart-page-title">

    سلة المشتريات

</h1>

@if (!CartService.Items.Any())
{
    <div class="empty-cart">

        <div>
            سلة المشتريات فارغة
        </div>

        <button class="continue-shopping-button"
                @onclick="ContinueShopping">
            متابعة التسوق
        </button>

    </div>
}
else
{
    <div class="cart-items-container">

        @foreach (var item in CartService.Items)
        {
            <div class="cart-item-card">

                <img src="@item.ProductImageUrl"
                     class="cart-item-image" />

                <div class="cart-item-content">

                    <div class="cart-item-name">
                        @item.ProductName
                    </div>

                    <div class="cart-item-serial">
                        SN: @item.ProductSerialNumber
                    </div>

                    @if (item.CategoryNames.Any())
                    {
                        <div class="product-category-list cart-category-list">
                            @foreach (var categoryName in item.CategoryNames)
                            {
                                <span class="product-category-badge">@categoryName</span>
                            }
                        </div>
                    }

                    <div class="cart-item-size">
                        المقاس: @item.Size
                    </div>

                    @if (item.ReviewMessage is not null)
                    {
                        <div class="error-message" dir="rtl">@item.ReviewMessage</div>
                    }

                    <div class="cart-item-size">
                        الكمية المتوفرة: @item.MaxAvailableQuantity
                    </div>

                    <div class="cart-item-price">
                        ₪@item.UnitPrice
                    </div>

                    @if (item.ProductDiscounts.Any(x => x.Discount.IsActive && x.Discount.RuleType != DiscountRuleType.FixedSalePrice))
                    {
                        <div class="cart-item-offers">
                            @foreach (var pd in item.ProductDiscounts.Where(x => x.Discount.IsActive && x.Discount.RuleType != DiscountRuleType.FixedSalePrice))
                            {
                                <div>@GetDiscountText(pd.Discount)</div>
                            }
                        </div>
                    }

                </div>

                <div class="cart-item-actions">

                    <div class="cart-quantity-container">

                        <button class="quantity-button"
                                @onclick="(() => Decrease(item))">

                            -

                        </button>

                        <span class="quantity-value">

                            @item.Quantity

                        </span>

                        <button class="quantity-button"
                                disabled="@(item.Quantity >= item.MaxAvailableQuantity)"
                                @onclick="(() => Increase(item))">

                            +

                        </button>

                    </div>

                    <div class="cart-total-price">

                        ₪@item.TotalPrice

                    </div>

                    <button class="remove-item-button"
                            @onclick="(() => Remove(item))">

                        حذف

                    </button>

                </div>

            </div>
        }

    </div>

    <div class="cart-summary">

        @{
            var discountResult = CartService.CalculateBestDiscount();
        }

        <div class="cart-summary-total">
            <div>السعر قبل التخفيض: ₪@discountResult.OriginalTotal</div>

            @if (discountResult.DiscountAmount > 0)
            {
                <div class="discount-summary">
                    <strong>قيمة التخفيض:</strong> ₪@discountResult.DiscountAmount
                </div>
            }

            <div>
                <strong>المجموع النهائي:</strong> ₪@discountResult.FinalTotal
            </div>

            <div class="delivery-price-note">
                السعر لا يشمل التوصيل
            </div>
        </div>

        <div style="display:flex; gap:15px;">

            <button class="continue-shopping-button"
                    @onclick="ContinueShopping">
                متابعة التسوق
            </button>

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="error-message">
                    @ErrorMessage
                </div>
            }

            <button class="checkout-button"
                    disabled="@IsSubmittingOrder"
                    @onclick="OpenCheckout">
                إرسال الطلب
            </button>

        </div>

    </div>


}

<CheckoutModal IsOpen="IsCheckoutOpen"
                SubmissionError="@ErrorMessage"
                OnClose="CloseCheckout"
                OnConfirm="ConfirmOrder" />

@if (IsOrderSuccess)
{
    <div class="modal-overlay">
        <div class="success-modal">

            <h2 dir="rtl">تم إرسال الطلب بنجاح</h2>
            <p dir="rtl">رقم الطلب: <strong dir="ltr">@SuccessfulOrderNumber</strong></p>

            <button class="checkout-button"
                    @onclick="CloseSuccess">
                OK
            </button>

        </div>
    </div>
}

@code {
    protected override void OnInitialized() => CartService.OnChange += CartChanged;
    private void CartChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => CartService.OnChange -= CartChanged;
    private bool IsOrderSuccess;
    private bool IsCheckoutOpen;
    private bool IsSubmittingOrder;
    private string ErrorMessage = string.Empty;
    private string SuccessfulOrderNumber = string.Empty;
    private const string AttemptStorageKey = "larafashion.checkout.attempt";
    private sealed record PendingCheckout(Guid Id, string CartHash, int Version = 0);

    private string LegacyCartHash() => Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(
        System.Text.Encoding.UTF8.GetBytes(System.Text.Json.JsonSerializer.Serialize(CartService.Items
            .OrderBy(x => x.ProductId).ThenBy(x => x.Size).Select(x => new { x.ProductId, x.Size, x.Quantity })))));
    private string CartHash() => Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(
        System.Text.Encoding.UTF8.GetBytes(System.Text.Json.JsonSerializer.Serialize(CartService.Items
            .OrderBy(x => x.ProductId).ThenBy(x => x.ProductSizeId).ThenBy(x => x.Size)
            .Select(x => new { x.ProductId, x.ProductSizeId, x.Size, x.Quantity })))));

    private async Task<PendingCheckout?> ReadPendingCheckout()
    {
        var json = await JS.InvokeAsync<string?>("sessionStorage.getItem", AttemptStorageKey);
        try { return json is null ? null : System.Text.Json.JsonSerializer.Deserialize<PendingCheckout>(json); }
        catch (System.Text.Json.JsonException) { return null; }
    }

    private async Task<bool> RecoverCheckout()
    {
        var pending = await ReadPendingCheckout();
        if (pending is null) return false;
        var receipt = await OrderService.GetCheckoutReceiptAsync(pending.Id);
        if (receipt is null) return false;
        if (pending.CartHash == (pending.Version >= 2 ? CartHash() : LegacyCartHash())) CartService.Clear();
        SuccessfulOrderNumber = receipt.OrderNumber;
        IsCheckoutOpen = false;
        IsOrderSuccess = true;
        await JS.InvokeVoidAsync("sessionStorage.removeItem", AttemptStorageKey);
        return true;
    }

    private void Remove(LaraFashion.Models.CartItem item)
    {
        CartService.RemoveItem(item);
    }

    private void Increase(LaraFashion.Models.CartItem item)
    {
        CartService.IncreaseQuantity(item);
    }

    private void Decrease(LaraFashion.Models.CartItem item)
    {
        CartService.DecreaseQuantity(item);
    }

    private void ContinueShopping()
    {
        Navigation.NavigateTo("/");
    }

    private async Task OpenCheckout()
    {
        ErrorMessage = string.Empty;
        if (await RecoverCheckout()) return;
        await RefreshCartQuantitiesAsync();

        if (!CartService.Items.Any())
        {
            ErrorMessage = "تم تحديث السلة. بعض المنتجات لم تعد متوفرة.";
            return;
        }

        if (CartService.Items.Any(i => i.ReviewMessage is not null))
        { ErrorMessage = "راجع العناصر المحددة في السلة قبل إرسال الطلب."; return; }

        IsCheckoutOpen = true;
    }

    private Task CloseCheckout()
    {
        IsCheckoutOpen = false;
        return Task.CompletedTask;
    }

    private async Task RefreshCartQuantitiesAsync()
    {
        var validItems = await ProductService.BuildValidCartItemsAsync(
            CartService.ToPersistedItems(),
            await IsAdminSessionValidAsync());

        CartService.ReplaceItems(validItems);

        if (validItems.Any(i => i.ReviewMessage is not null))
            ErrorMessage = "راجع العناصر المحددة في السلة قبل إرسال الطلب.";
    }

    private async Task ConfirmOrder(CustomerInfo customer)
    {
        if (IsSubmittingOrder)
            return;

        try
        {
            IsSubmittingOrder = true;
            ErrorMessage = string.Empty;
            if (await RecoverCheckout()) return;

            await RefreshCartQuantitiesAsync();

            if (!CartService.Items.Any())
            {
                IsCheckoutOpen = false;
                ErrorMessage = "تم تحديث السلة. المنتجات المختارة لم تعد متوفرة.";
                return;
            }

            if (CartService.Items.Any(i => i.ReviewMessage is not null)) return;
            var discountResult = CartService.CalculateBestDiscount();
            var pending = await ReadPendingCheckout() ?? new PendingCheckout(Guid.NewGuid(), CartHash(), 2);
            pending = pending with { CartHash = CartHash(), Version = 2 };
            await JS.InvokeVoidAsync("sessionStorage.setItem", AttemptStorageKey, System.Text.Json.JsonSerializer.Serialize(pending));

            var savedOrder = await OrderService.CreateOrderAsync(
                customer,
                CartService.Items.ToList(),
                discountResult,
                await IsAdminSessionValidAsync(),
                pending.Id);

            IsCheckoutOpen = false;

            CartService.Clear();

            SuccessfulOrderNumber = savedOrder.OrderNumber;
            IsOrderSuccess = true;
            await JS.InvokeVoidAsync("sessionStorage.removeItem", AttemptStorageKey);
        }
        catch (InvalidOperationException ex)
        {
            ErrorMessage = ex.Message;
            return;
        }
        catch (Exception)
        {
            ErrorMessage = "تعذر تأكيد الطلب الآن. أعد المحاولة؛ سيتم التحقق من المحاولة السابقة قبل إنشاء طلب آخر.";
        }
        finally
        {
            IsSubmittingOrder = false;
        }
    }

    private async Task<bool> IsAdminSessionValidAsync()
    {
        var token = await BrowserStorageService.GetItemAsync("admin_token");
        return !string.IsNullOrWhiteSpace(token) && AdminAuthService.IsTokenValid(token);
    }

    private void CloseSuccess()
    {
        IsOrderSuccess = false;

        Navigation.NavigateTo("/");
    }

    private string GetDiscountText(Discount discount)
    {
        return discount.RuleType switch
        {
            DiscountRuleType.ProductDirect =>
                discount.ValueType == DiscountValueType.Percent
                    ? $"خصم مباشر {discount.Value}%"
                    : $"خصم مباشر ₪{discount.Value}",

            DiscountRuleType.QuantityBased =>
                discount.ValueType == DiscountValueType.Percent
                    ? $"اشترِ {discount.MinimumQuantity} قطع أو أكثر واحصل على خصم {discount.Value}%"
                    : $"اشترِ {discount.MinimumQuantity} قطع أو أكثر واحصل على خصم ₪{discount.Value}",

            DiscountRuleType.AmountBased =>
                discount.ValueType == DiscountValueType.Percent
                    ? $"عند الشراء بقيمة ₪{discount.MinimumAmount} أو أكثر احصل على خصم {discount.Value}%"
                    : $"عند الشراء بقيمة ₪{discount.MinimumAmount} أو أكثر احصل على خصم ₪{discount.Value}",

            DiscountRuleType.BundleFixedPrice =>
                $"اشترِ {discount.MinimumQuantity} قطع من هذه المجموعة بسعر ₪{discount.BundleFixedTotalPrice} — يتم حساب التخفيض في السلة",

            DiscountRuleType.FixedSalePrice => string.Empty,

            _ => discount.Name
        };
    }

}
