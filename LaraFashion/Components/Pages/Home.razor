@page "/"

@using LaraFashion.Models
@using LaraFashion.Components.Store
@using LaraFashion.Components.Modals

@inject LaraFashion.Services.ProductService ProductService
@inject LaraFashion.Services.CategoryService CategoryService

<div class="lf-filter-panel store-category-filter" dir="rtl" style="display:inline-flex;align-items:center;gap:14px;padding:14px 18px;border-radius:22px;background:rgba(255,255,255,.92);box-shadow:0 10px 28px rgba(15,23,42,.10);border:1px solid rgba(226,232,240,.95);margin:18px 0 24px;max-width:100%;">
    <div class="lf-filter-text" style="display:flex;flex-direction:column;gap:3px;min-width:120px;text-align:right;color:#64748b;font-weight:800;">
        <span class="lf-filter-kicker" style="font-size:12px;line-height:1;color:#94a3b8;font-weight:900;">تصفية المنتجات</span>
        <strong style="font-size:16px;line-height:1.2;color:#334155;font-weight:950;">اختر التصنيف</strong>
    </div>

    <div class="lf-select-wrap" style="position:relative;min-width:190px;">
        <select class="lf-modern-select" style="width:100%;height:54px;border:0;border-radius:18px;padding:0 46px 0 18px;color:#111827;background:linear-gradient(135deg,#e0f2fe,#ede9fe);font-size:16px;font-weight:950;box-shadow:0 12px 24px rgba(124,58,237,.22), inset 0 1px 0 rgba(255,255,255,.25);outline:none;appearance:none;-webkit-appearance:none;cursor:pointer;text-align:center;"
                value="@SelectedCategoryId.ToString()"
                @onchange="OnStoreCategoryChanged">
            <option style="color:#111827;background:white;" value="@Guid.Empty.ToString()">كل المنتجات</option>
            @foreach (var category in Categories)
            {
                <option style="color:#111827;background:white;" value="@category.Id.ToString()">@category.Name</option>
            }
        </select>
    </div>
</div>

@if (IsLoading)
{
    <div class="empty-cart">
        Loading products...
    </div>
}
else if (!Products.Any())
{
    <div class="empty-cart">
        No products available yet
    </div>
}
else
{
    <div class="products-grid">
        @foreach (var product in Products)
        {
            <div @onclick="(() => OpenProduct(product))">
                <ProductCard Product="product" />
            </div>
        }
    </div>
}

<ProductModal IsOpen="IsModalOpen"
              Product="SelectedProduct"
              OnClose="CloseModal" />

@code {
    private bool IsLoading = true;
    private bool IsModalOpen;
    private Product SelectedProduct = new();
    private List<Product> Products = new();
    private List<Category> Categories = new();
    private Guid SelectedCategoryId = Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        Categories = await CategoryService.GetActiveAsync();
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        IsLoading = true;
        Products = await ProductService.GetActiveProductsAsync(SelectedCategoryId == Guid.Empty ? null : SelectedCategoryId);
        IsLoading = false;
    }

    private async Task OnStoreCategoryChanged(ChangeEventArgs e)
    {
        var rawValue = e.Value?.ToString();

        SelectedCategoryId = Guid.TryParse(rawValue, out var categoryId)
            ? categoryId
            : Guid.Empty;

        await LoadProducts();
    }

    private void OpenProduct(Product product)
    {
        SelectedProduct = product;
        IsModalOpen = true;
    }

    private Task CloseModal()
    {
        IsModalOpen = false;
        return Task.CompletedTask;
    }
}
