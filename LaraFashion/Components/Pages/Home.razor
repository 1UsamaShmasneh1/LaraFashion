@page "/"

@using LaraFashion.Models
@using LaraFashion.Components.Store
@using LaraFashion.Components.Modals

@inject LaraFashion.Services.ProductService ProductService
@inject LaraFashion.Services.CategoryService CategoryService
@inject LaraFashion.Services.StorefrontFilterState FilterState
@inject IJSRuntime JS
@inject ILogger<Home> Logger
@implements IDisposable

<div class="category-button-bar store-category-filter" dir="rtl">
    <button type="button"
            class="category-filter-button @(SelectedCategoryId == Guid.Empty ? "active" : string.Empty)"
            @onclick="(() => SelectStoreCategory(Guid.Empty))">
        كل المنتجات
    </button>

    @foreach (var category in Categories)
    {
        <button type="button"
                class="category-filter-button @(SelectedCategoryId == category.Id ? "active" : string.Empty)"
                @onclick="(() => SelectStoreCategory(category.Id))">
            @category.Name
        </button>
    }
</div>

@if (!string.IsNullOrWhiteSpace(FilterState.Size))
{
    <div class="store-size-filter" dir="rtl">
        <span>المقاس: @FilterState.Size</span>
        <button type="button" title="إلغاء فلتر المقاس" @onclick="ClearSizeFilter">×</button>
    </div>
}

@if (IsLoading)
{
    <div class="empty-cart">
        جاري تحميل المنتجات...
    </div>
}
else if (!Products.Any())
{
    <div class="empty-cart">
        لا يوجد منتجات للعرض
    </div>
}
else
{
    <div class="products-grid">
        @foreach (var product in Products)
        {
            <div @onclick="(() => OpenProduct(product))">
                <ProductCard Product="product" />
            </div>
        }
    </div>
}

<ProductModal IsOpen="IsModalOpen"
              Product="SelectedProduct"
              OnClose="CloseModal" />

@code {
    private bool IsLoading = true;
    private bool IsModalOpen;
    private Product SelectedProduct = new();
    private List<Product> Products = new();
    private List<Category> Categories = new();
    private Guid SelectedCategoryId = Guid.Empty;
    private readonly CancellationTokenSource refreshCancellation = new();

    protected override async Task OnInitializedAsync()
    {
        FilterState.Changed += OnFilterChanged;
        Categories = await CategoryService.GetActiveAsync();
        await LoadProducts();
        _ = RefreshAvailabilityAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("storeVisits.record");
    }

    private async Task LoadProducts(bool quiet = false)
    {
        if (!quiet) IsLoading = true;
        var category = SelectedCategoryId;
        var size = FilterState.Size;
        var products = await ProductService.GetActiveProductsAsync(category == Guid.Empty ? null : category, size);
        if (category == SelectedCategoryId && size == FilterState.Size && !refreshCancellation.IsCancellationRequested)
        {
            Products = products;
            if (IsModalOpen)
            {
                var selected = products.FirstOrDefault(x => x.Id == SelectedProduct.Id)
                    ?? await ProductService.GetProductAsync(SelectedProduct.Id);
                if (selected is null || !selected.IsActive) IsModalOpen = false;
                else SelectedProduct = selected;
            }
        }
        IsLoading = false;
    }

    private async Task RefreshAvailabilityAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await timer.WaitForNextTickAsync(refreshCancellation.Token))
                await InvokeAsync(async () =>
                {
                    try { await LoadProducts(quiet: true); StateHasChanged(); }
                    catch { Logger.LogWarning("Could not refresh storefront availability."); }
                });
        }
        catch (OperationCanceledException) { }
    }

    private Task ClearSizeFilter() => FilterState.ClearSizeAsync();

    private Task OnFilterChanged() => InvokeAsync(async () =>
    {
        await LoadProducts();
        StateHasChanged();
    });

    public void Dispose()
    {
        FilterState.Changed -= OnFilterChanged;
        refreshCancellation.Cancel();
    }

    private async Task SelectStoreCategory(Guid categoryId)
    {
        SelectedCategoryId = categoryId;
        await LoadProducts();
    }

    private async Task OpenProduct(Product product)
    {
        var fresh = await ProductService.GetProductAsync(product.Id);
        if (fresh is null || !fresh.IsActive || !fresh.Sizes.Any(x => x.Quantity > 0))
        {
            await LoadProducts();
            return;
        }
        SelectedProduct = fresh;
        IsModalOpen = true;
    }

    private Task CloseModal()
    {
        IsModalOpen = false;
        return Task.CompletedTask;
    }
}
