@page "/"

@using LaraFashion.Models
@using LaraFashion.Components.Store
@using LaraFashion.Components.Modals

@inject LaraFashion.Services.ProductService ProductService
@inject LaraFashion.Services.CategoryService CategoryService

<div class="lf-filter-panel store-category-filter" dir="rtl">
    <div class="lf-filter-text">
        <span class="lf-filter-kicker">تصفية المنتجات</span>
        <strong>اختر التصنيف</strong>
    </div>

    <div class="lf-select-wrap">
        <select class="lf-modern-select"
                value="@SelectedCategoryId.ToString()"
                @onchange="OnStoreCategoryChanged">
            <option value="@Guid.Empty.ToString()">كل المنتجات</option>
            @foreach (var category in Categories)
            {
                <option value="@category.Id.ToString()">@category.Name</option>
            }
        </select>
    </div>
</div>

@if (IsLoading)
{
    <div class="empty-cart">
        Loading products...
    </div>
}
else if (!Products.Any())
{
    <div class="empty-cart">
        No products available yet
    </div>
}
else
{
    <div class="products-grid">
        @foreach (var product in Products)
        {
            <div @onclick="(() => OpenProduct(product))">
                <ProductCard Product="product" />
            </div>
        }
    </div>
}

<ProductModal IsOpen="IsModalOpen"
              Product="SelectedProduct"
              OnClose="CloseModal" />

@code {
    private bool IsLoading = true;
    private bool IsModalOpen;
    private Product SelectedProduct = new();
    private List<Product> Products = new();
    private List<Category> Categories = new();
    private Guid SelectedCategoryId = Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        Categories = await CategoryService.GetActiveAsync();
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        IsLoading = true;
        Products = await ProductService.GetActiveProductsAsync(SelectedCategoryId == Guid.Empty ? null : SelectedCategoryId);
        IsLoading = false;
    }

    private async Task OnStoreCategoryChanged(ChangeEventArgs e)
    {
        var rawValue = e.Value?.ToString();

        SelectedCategoryId = Guid.TryParse(rawValue, out var categoryId)
            ? categoryId
            : Guid.Empty;

        await LoadProducts();
    }

    private void OpenProduct(Product product)
    {
        SelectedProduct = product;
        IsModalOpen = true;
    }

    private Task CloseModal()
    {
        IsModalOpen = false;
        return Task.CompletedTask;
    }
}
