@page "/admin/products"

@using LaraFashion.Models
@using LaraFashion.Models.Enums
@using SkiaSharp

@inject IWebHostEnvironment WebHostEnvironment
@inject LaraFashion.Services.ProductService ProductService
@inject LaraFashion.Services.AdminAuthService AdminAuthService
@inject LaraFashion.Services.BrowserStorageService BrowserStorageService
@inject LaraFashion.Services.DiscountService DiscountService
@inject LaraFashion.Services.CategoryService CategoryService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<AdminNav />

<h1 class="admin-page-title">
    المنتجات
</h1>

<div class="lf-filter-panel admin-category-select-bar" dir="rtl" style="display:inline-flex;align-items:center;gap:14px;padding:14px 18px;border-radius:22px;background:rgba(255,255,255,.92);box-shadow:0 10px 28px rgba(15,23,42,.10);border:1px solid rgba(226,232,240,.95);margin:18px 0 24px;max-width:100%;flex-wrap:wrap;">
    <button type="button" class="checkout-button admin-add-product-button"
            style="height:54px;border:0;border-radius:18px;padding:0 26px;margin:0;color:white;background:linear-gradient(135deg,#38bdf8,#7c3aed);font-size:16px;font-weight:950;box-shadow:0 12px 24px rgba(124,58,237,.22);white-space:nowrap;"
            @onclick="OpenAddModal">
        اضافة منتج
    </button>
    <div class="lf-filter-text" style="display:flex;flex-direction:column;gap:3px;min-width:120px;text-align:right;color:#64748b;font-weight:800;">
        <span class="lf-filter-kicker" style="font-size:12px;line-height:1;color:#94a3b8;font-weight:900;">إدارة المنتجات</span>
        <strong style="font-size:16px;line-height:1.2;color:#334155;font-weight:950;">تصفية حسب التصنيف</strong>
    </div>

    <div class="lf-select-wrap" style="position:relative;min-width:190px;">
        <select class="lf-modern-select" style="width:100%;height:54px;border:0;border-radius:18px;padding:0 46px 0 18px;color:#111827;background:linear-gradient(135deg,#e0f2fe,#ede9fe);font-size:16px;font-weight:950;box-shadow:0 12px 24px rgba(124,58,237,.22), inset 0 1px 0 rgba(255,255,255,.25);outline:none;appearance:none;-webkit-appearance:none;cursor:pointer;text-align:center;"
                value="@SelectedFilterCategoryId.ToString()"
                @onchange="OnAdminCategoryFilterChanged">
            <option style="color:#111827;background:white;" value="@Guid.Empty.ToString()">كل التصنيفات</option>
            @foreach (var category in AvailableCategories)
            {
                <option style="color:#111827;background:white;" value="@category.Id.ToString()">@category.Name</option>
            }
        </select>
    </div>
</div>

@if (SelectedProductIds.Any())
{
    <div class="admin-bulk-panel" dir="rtl">
        <div class="admin-bulk-title">
            تم اختيار @SelectedProductIds.Count منتج
        </div>

        <div class="admin-bulk-section">
            <strong>تعديل التصنيفات للمنتجات المختارة</strong>
            <div class="discount-select-list bulk-check-list">
                @foreach (var category in AvailableCategories)
                {
                    <label class="discount-check-row">
                        <input type="checkbox"
                               checked="@BulkCategoryIds.Contains(category.Id)"
                               @onchange="e => ToggleBulkCategory(category.Id, e.Value)" />
                        <span>@category.Name</span>
                    </label>
                }
            </div>
            <button type="button" class="checkout-button bulk-action-button" @onclick="ApplyBulkCategories">
                حفظ التصنيفات
            </button>
        </div>

        <div class="admin-bulk-section">
            <strong>تعديل التخفيضات للمنتجات المختارة</strong>
            <div class="discount-select-list bulk-check-list">
                @foreach (var discount in AvailableDiscounts)
                {
                    <label class="discount-check-row">
                        <input type="checkbox"
                               checked="@BulkDiscountIds.Contains(discount.Id)"
                               @onchange="e => ToggleBulkDiscount(discount.Id, e.Value)" />
                        <span>@discount.Name - @GetDiscountSummary(discount)</span>
                    </label>
                }
            </div>
            <button type="button" class="checkout-button bulk-action-button" @onclick="ApplyBulkDiscounts">
                حفظ التخفيضات
            </button>
        </div>

        <div class="admin-bulk-actions">
            <button type="button" class="continue-shopping-button" @onclick="ClearSelectedProducts">
                إلغاء التحديد
            </button>
            <button type="button" class="remove-item-button" @onclick="DeleteSelectedProducts">
                حذف المنتجات المختارة
            </button>
        </div>
    </div>
}

@if (IsLoading)
{
    <div class="empty-cart">
        Loading...
    </div>
}
else if (!Products.Any())
{
    <div class="empty-cart">
        لا يجد منتجات للعرض
    </div>
}
else
{
    <div class="admin-selection-tools" dir="rtl">
        <button type="button" class="continue-shopping-button" @onclick="SelectAllVisibleProducts">تحديد كل الظاهر</button>
    </div>

    <div class="products-grid admin-products-grid">

        @foreach (var product in Products)
        {
            <div class="product-card admin-product-card @(SelectedProductIds.Contains(product.Id) ? "selected-product-card" : string.Empty)">

                <label class="admin-product-select">
                    <input type="checkbox"
                           checked="@SelectedProductIds.Contains(product.Id)"
                           @onchange="e => ToggleProductSelection(product.Id, e.Value)" />
                    <span>تحديد</span>
                </label>

                <div class="product-image-container">

                    @if (!string.IsNullOrWhiteSpace(product.PrimaryImageUrl))
                    {
                        <img src="@product.PrimaryImageUrl" class="product-image" />
                    }
                    else
                    {
                        <div class="product-image-placeholder">
                            لا توجد صورة
                        </div>
                    }

                </div>

                <div class="product-content">

                    <div class="product-name">
                        @product.Name
                    </div>

                    <div class="product-publish-status"
                         style="display:inline-flex;width:max-content;margin:6px 0 10px;padding:7px 12px;border-radius:999px;background:@(product.IsPublished ? "#dcfce7" : "#fff7ed");color:@(product.IsPublished ? "#166534" : "#9a3412");font-weight:950;font-size:13px;">
                        @(product.IsPublished ? "منشور" : "غير منشور")
                    </div>

                    <div class="product-serial">
                        SN: @product.SerialNumber
                    </div>

                    <div class="final-price">
                        ₪@product.FinalPrice
                    </div>

                    @if (product.ProductCategories.Any(x => x.Category.IsActive))
                    {
                        <div class="product-category-list">
                            @foreach (var pc in product.ProductCategories.Where(x => x.Category.IsActive))
                            {
                                <span class="product-category-badge">@pc.Category.Name</span>
                            }
                        </div>
                    }

                    @if (product.ProductDiscounts.Any(x => x.Discount.IsActive))
                    {
                        <div class="product-card-discounts">
                            @foreach (var pd in product.ProductDiscounts.Where(x => x.Discount.IsActive))
                            {
                                <div class="product-card-discount">
                                    @GetDiscountSummary(pd.Discount)
                                </div>
                            }
                        </div>
                    }

                    <div class="admin-product-actions">
                        <button type="button" class="continue-shopping-button"
                                @onclick="(() => OpenEditModal(product))">
                            تعديل
                        </button>

                        @if (!product.IsPublished)
                        {
                            <button type="button" class="checkout-button"
                                    style="padding:10px 8px;font-size:14px;border-radius:12px;"
                                    @onclick="(() => ConfirmPublishProduct(product.Id))">
                                نشر المنتج
                            </button>
                        }

                        <button type="button" class="remove-item-button"
                                @onclick="(() => ConfirmDeleteProduct(product.Id))">
                            حذف
                        </button>
                    </div>

                </div>

            </div>
        }

    </div>
}

@if (IsAddModalOpen)
{
    <div class="modal-overlay">

        <div class="checkout-modal" @onclick:stopPropagation="true">

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="checkout-error">
                    @ErrorMessage
                </div>
            }

            <h2>@(IsEditMode ? "Edit Product" : "Add Product")</h2>

            <div class="form-group">
                <label>الاسم</label>
                <input @bind="NewProduct.Name" />
            </div>

            <div class="form-group">
                <label>رقم السلسلة</label>
                <input @bind="NewProduct.SerialNumber" />
            </div>

            <div class="form-group">
                <label>الوصف</label>
                <input @bind="NewProduct.Description" />
            </div>

            <div class="form-group">
                <label>السعر</label>
                <input type="number"
                       @bind="NewProduct.OriginalPrice" />
            </div>

            <div class="form-group">
                <label>Image</label>

                <input id="productImageUploadInput"
                       type="file"
                       multiple
                       accept="image/*,.jpg,.jpeg,.png,.webp"
                       onchange="laraFashionUploadProductImages(this)" />

                <input id="productImageUrlsInput"
                       type="hidden"
                       @onchange="OnUploadedImageUrlChanged" />

                <div id="productImageUploadStatus"
                     class="delivery-price-note"
                     style="margin-top:8px;font-weight:800;">
                    @if (SelectedImages.Any())
                    {
                        <span>@SelectedImages.Count صورة جاهزة للحفظ.</span>
                    }
                </div>

                @if (SelectedImages.Any())
                {
                    <div class="admin-product-images-editor" dir="rtl">
                        @foreach (var image in SelectedImages.OrderBy(x => x.SortOrder))
                        {
                            <div @key="image.Id" class="admin-product-image-editor @(image.IsPrimary ? "is-primary" : string.Empty)">
                                <img src="@image.ImageUrl" alt="" />
                                @if (image.IsPrimary)
                                {
                                    <span class="admin-product-image-primary-badge">الصورة الرئيسية</span>
                                }
                                <div class="admin-product-image-actions">
                                    <button type="button" disabled="@image.IsPrimary" @onclick="(() => MakeImagePrimary(image.Id))">رئيسية</button>
                                    <button type="button" disabled="@(image.SortOrder == 0)" @onclick="(() => MoveImage(image.Id, -1))">↑</button>
                                    <button type="button" disabled="@(image.SortOrder == SelectedImages.Count - 1)" @onclick="(() => MoveImage(image.Id, 1))">↓</button>
                                    <button type="button" class="remove-image" @onclick="(() => RemoveImage(image.Id))">إزالة</button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <h3>التصنيفات المتاحة</h3>

            @if (!AvailableCategories.Any())
            {
                <div class="delivery-price-note">
                    لا توجد تصنيفات حالياً
                </div>
            }
            else
            {
                <div class="discount-select-list">
                    @foreach (var category in AvailableCategories)
                    {
                        <label class="discount-check-row">
                            <input type="checkbox"
                                   checked="@SelectedCategoryIds.Contains(category.Id)"
                                   @onchange="e => ToggleCategory(category.Id, e.Value)" />

                            <span>@category.Name</span>
                        </label>
                    }
                </div>
            }

            <h3>التخفيضات المتاحة</h3>

            @if (!AvailableDiscounts.Any())
            {
                <div class="delivery-price-note">
                    لا توجد تخفيضات فعالة حالياً
                </div>
            }
            else
            {
                <div class="discount-select-list">
                    @foreach (var discount in AvailableDiscounts)
                    {
                        <label class="discount-check-row">
                            <input type="checkbox"
                                   checked="@SelectedDiscountIds.Contains(discount.Id)"
                                   @onchange="e => ToggleDiscount(discount.Id, e.Value)" />

                            <span>
                                @discount.Name -
                                @GetDiscountSummary(discount)
                            </span>
                        </label>
                    }
                </div>
            }

            <h3>Sizes</h3>

            @foreach (var size in NewProduct.Sizes)
            {
                <div class="size-admin-row">

                    <input placeholder="Size"
                           @bind="size.SizeName" />

                    <input type="number"
                           placeholder="Quantity"
                           @bind="size.Quantity" />

                </div>
            }

            <button type="button"
                    class="continue-shopping-button mb-3"
                    @onclick="AddSize">
                اضافة مقاس جديد
            </button>

            <div class="checkout-buttons">

                <button type="button"
                        class="continue-shopping-button"
                        @onclick="CloseAddModal">
                    الغاء
                </button>

                <button type="button"
                        class="checkout-button"
                        disabled="@IsSaving"
                        @onclick="SaveProduct">
                    @(IsSaving ? "حفظ..." : IsEditMode ? "تعديل المنتج" : "حفظ المنتج")
                </button>

            </div>

        </div>

    </div>
}

<style>
    .admin-product-images-editor {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 12px;
        margin-top: 14px;
    }

    .admin-product-image-editor {
        position: relative;
        min-width: 0;
        padding: 8px;
        border: 2px solid #e2e8f0;
        border-radius: 16px;
        background: #f8fafc;
    }

    .admin-product-image-editor.is-primary {
        border-color: #7c3aed;
    }

    .admin-product-image-editor > img {
        display: block;
        width: 100%;
        height: 120px;
        object-fit: contain;
        border-radius: 12px;
        background: white;
    }

    .admin-product-image-primary-badge {
        display: block;
        margin-top: 7px;
        color: #6d28d9;
        font-size: 12px;
        font-weight: 900;
        text-align: center;
    }

    .admin-product-image-actions {
        display: grid;
        grid-template-columns: 1fr auto auto;
        gap: 6px;
        margin-top: 8px;
    }

    .admin-product-image-actions > button {
        min-height: 34px;
        border: 0;
        border-radius: 9px;
        padding: 5px 8px;
        background: #e2e8f0;
        color: #334155;
        font-weight: 850;
        cursor: pointer;
    }

    .admin-product-image-actions > button:disabled {
        cursor: default;
        opacity: .45;
    }

    .admin-product-image-actions > .remove-image {
        grid-column: 1 / -1;
        background: #fee2e2;
        color: #b91c1c;
    }
</style>

@code {

    private bool IsLoading = true;

    private bool IsAddModalOpen;

    private bool IsEditMode;

    private string ErrorMessage = string.Empty;
    
    private bool IsSaving;

    private List<Product> Products = new();

    private Product NewProduct = new();

    private List<Discount> AvailableDiscounts = new();

    private List<Category> AvailableCategories = new();

    private List<Guid> SelectedDiscountIds = new();

    private List<Guid> SelectedCategoryIds = new();

    private HashSet<Guid> SelectedProductIds = new();

    private List<Guid> BulkDiscountIds = new();

    private List<Guid> BulkCategoryIds = new();

    private Guid SelectedFilterCategoryId = Guid.Empty;

    private Guid EditingProductId = Guid.Empty;

    private List<ProductImage> SelectedImages = new();


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var token =
            await BrowserStorageService.GetItemAsync("admin_token");

        if (string.IsNullOrWhiteSpace(token) ||
            !AdminAuthService.IsTokenValid(token))
        {
            Navigation.NavigateTo("/admin/login");
            return;
        }

        await LoadProducts();

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadProducts()
    {
        Products = await ProductService.GetAllProductsAsync(SelectedFilterCategoryId == Guid.Empty ? null : SelectedFilterCategoryId);
        AvailableDiscounts = await DiscountService.GetActiveAsync();
        AvailableCategories = await CategoryService.GetActiveAsync();

        IsLoading = false;
    }

    private void OpenAddModal()
    {
        ErrorMessage = string.Empty;
        IsEditMode = false;
        SelectedDiscountIds = new();
        SelectedCategoryIds = new();
        EditingProductId = Guid.Empty;
        SelectedImages = new();

        NewProduct = new Product
        {
            Sizes = new()
        };

        IsAddModalOpen = true;
    }

    private void CloseAddModal()
    {
        ErrorMessage = string.Empty;
        ResetProductForm();
        StateHasChanged();
    }

    private void AddSize()
    {
        NewProduct.Sizes.Add(new ProductSize());
    }

    private async Task SaveProduct()
    {
        if (IsSaving)
            return;

        try
        {
            IsSaving = true;
            ErrorMessage = string.Empty;

            NewProduct.DiscountType = DiscountType.None;
            NewProduct.DiscountValue = 0;

            NormalizeSelectedImages();
            NewProduct.Images = SelectedImages.Select(x => new ProductImage
            {
                Id = x.Id,
                ProductId = NewProduct.Id,
                ImageUrl = x.ImageUrl,
                SortOrder = x.SortOrder,
                IsPrimary = x.IsPrimary
            }).ToList();
            NewProduct.ImageUrl = NewProduct.Images.FirstOrDefault(x => x.IsPrimary)?.ImageUrl
                ?? NewProduct.Images.FirstOrDefault()?.ImageUrl
                ?? string.Empty;

            if (string.IsNullOrWhiteSpace(NewProduct.Name))
            {
                ErrorMessage = "اسم المنتج مطلوب.";
                return;
            }

            var isEditingExistingProduct = IsEditMode || EditingProductId != Guid.Empty;

            if (isEditingExistingProduct)
            {
                if (EditingProductId == Guid.Empty && NewProduct.Id == Guid.Empty)
                {
                    ErrorMessage = "تعذر تحديد المنتج المطلوب تعديله. أغلق النافذة وافتح تعديل المنتج مرة أخرى.";
                    return;
                }

                var productIdToUpdate = EditingProductId != Guid.Empty
                    ? EditingProductId
                    : NewProduct.Id;

                NewProduct.Id = productIdToUpdate;

                await ProductService.UpdateProductWithRelationsAsync(
                    NewProduct,
                    SelectedDiscountIds,
                    SelectedCategoryIds,
                    mustExist: true);
            }
            else
            {
                await ProductService.AddProductWithRelationsAsync(
                    NewProduct,
                    SelectedDiscountIds,
                    SelectedCategoryIds);
            }

            ResetProductForm();

            await LoadProducts();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsSaving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ResetProductForm()
    {
        IsAddModalOpen = false;
        IsEditMode = false;
        EditingProductId = Guid.Empty;
        SelectedImages = new();
        NewProduct = new Product();
        SelectedDiscountIds = new();
        SelectedCategoryIds = new();
    }

    private void OpenEditModal(Product product)
    {
        if (product.Id == Guid.Empty)
        {
            ErrorMessage = "هذا المنتج غير صالح ولا يمكن تعديله.";
            return;
        }

        ErrorMessage = string.Empty;
        IsEditMode = true;
        EditingProductId = product.Id;
        SelectedImages = product.Images
            .Where(x => !string.IsNullOrWhiteSpace(x.ImageUrl))
            .OrderBy(x => x.SortOrder)
            .ThenBy(x => x.Id)
            .Select(x => new ProductImage
            {
                Id = x.Id,
                ProductId = product.Id,
                ImageUrl = x.ImageUrl,
                SortOrder = x.SortOrder,
                IsPrimary = x.IsPrimary
            })
            .ToList();

        if (!SelectedImages.Any() && !string.IsNullOrWhiteSpace(product.ImageUrl))
        {
            SelectedImages.Add(new ProductImage
            {
                Id = Guid.NewGuid(),
                ProductId = product.Id,
                ImageUrl = product.ImageUrl,
                IsPrimary = true
            });
        }

        NormalizeSelectedImages();

        SelectedDiscountIds = product.ProductDiscounts
            .Select(x => x.DiscountId)
            .Where(x => x != Guid.Empty)
            .Distinct()
            .ToList();

        SelectedCategoryIds = product.ProductCategories
            .Select(x => x.CategoryId)
            .Where(x => x != Guid.Empty)
            .Distinct()
            .ToList();

        NewProduct = new Product
        {
            Id = product.Id,
            Name = product.Name,
            SerialNumber = product.SerialNumber,
            Description = product.Description,
            OriginalPrice = product.OriginalPrice,
            DiscountType = DiscountType.None,
            DiscountValue = 0,
            ImageUrl = product.ImageUrl,
            IsActive = product.IsActive,
            IsPublished = product.IsPublished,
            Sizes = product.Sizes.Select(x => new ProductSize
            {
                Id = x.Id,
                ProductId = x.ProductId,
                SizeName = x.SizeName,
                Quantity = x.Quantity
            }).ToList()
        };

        IsAddModalOpen = true;
    }

    private async Task ConfirmDeleteProduct(Guid id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "هل أنت متأكد من حذف المنتج؟ سيتم الحذف فقط إذا انتهت كل الكميات وكانت الطلبيات المرتبطة جاهزة أو ملغاة.");

        if (!confirmed)
            return;

        try
        {
            await ProductService.DeleteProductAsync(id);
            SelectedProductIds.Remove(id);
            await LoadProducts();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", ex.Message);
        }
    }

    private async Task ConfirmPublishProduct(Guid id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "هل تريد نشر هذا المنتج الآن؟ بعد النشر سيظهر في المتجر الرسمي إذا كان متوفراً بالمخزون.");

        if (!confirmed)
            return;

        await ProductService.PublishProductAsync(id);
        await LoadProducts();
    }

    private void ToggleProductSelection(Guid productId, object? value)
    {
        var isChecked = value is bool b && b;

        if (isChecked)
            SelectedProductIds.Add(productId);
        else
            SelectedProductIds.Remove(productId);
    }

    private void SelectAllVisibleProducts()
    {
        foreach (var product in Products)
            SelectedProductIds.Add(product.Id);
    }

    private void ClearSelectedProducts()
    {
        SelectedProductIds.Clear();
        BulkDiscountIds.Clear();
        BulkCategoryIds.Clear();
    }

    private void ToggleBulkDiscount(Guid discountId, object? value)
    {
        var isChecked = value is bool b && b;

        if (isChecked)
        {
            if (!BulkDiscountIds.Contains(discountId))
                BulkDiscountIds.Add(discountId);
        }
        else
        {
            BulkDiscountIds.Remove(discountId);
        }
    }

    private void ToggleBulkCategory(Guid categoryId, object? value)
    {
        var isChecked = value is bool b && b;

        if (isChecked)
        {
            if (!BulkCategoryIds.Contains(categoryId))
                BulkCategoryIds.Add(categoryId);
        }
        else
        {
            BulkCategoryIds.Remove(categoryId);
        }
    }

    private async Task ApplyBulkDiscounts()
    {
        if (!SelectedProductIds.Any())
            return;

        await ProductService.UpdateProductsDiscountsAsync(SelectedProductIds.ToList(), BulkDiscountIds);
        await LoadProducts();
    }

    private async Task ApplyBulkCategories()
    {
        if (!SelectedProductIds.Any())
            return;

        await ProductService.UpdateProductsCategoriesAsync(SelectedProductIds.ToList(), BulkCategoryIds);
        await LoadProducts();
    }

    private async Task DeleteSelectedProducts()
    {
        if (!SelectedProductIds.Any())
            return;

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"هل أنت متأكد من حذف {SelectedProductIds.Count} منتج؟ سيتم حذف المنتجات التي انتهت كل كمياتها وكانت طلبياتها جاهزة أو ملغاة فقط.");

        if (!confirmed)
            return;

        try
        {
            await ProductService.DeleteProductsAsync(SelectedProductIds.ToList()); //k
            ClearSelectedProducts();
            await LoadProducts();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", ex.Message);
            await LoadProducts();
        }
    }

    private void OnUploadedImageUrlChanged(ChangeEventArgs e)
    {
        var imageUrl = e.Value?.ToString();

        if (string.IsNullOrWhiteSpace(imageUrl))
            return;

        if (SelectedImages.Any(x => string.Equals(x.ImageUrl, imageUrl, StringComparison.OrdinalIgnoreCase)))
            return;

        SelectedImages.Add(new ProductImage
        {
            Id = Guid.NewGuid(),
            ProductId = NewProduct.Id,
            ImageUrl = imageUrl,
            SortOrder = SelectedImages.Count,
            IsPrimary = SelectedImages.Count == 0
        });

        NormalizeSelectedImages();
    }

    private void MakeImagePrimary(Guid imageId)
    {
        foreach (var image in SelectedImages)
            image.IsPrimary = image.Id == imageId;
    }

    private void RemoveImage(Guid imageId)
    {
        SelectedImages.RemoveAll(x => x.Id == imageId);
        NormalizeSelectedImages();
    }

    private void MoveImage(Guid imageId, int offset)
    {
        var orderedImages = SelectedImages.OrderBy(x => x.SortOrder).ToList();
        var currentIndex = orderedImages.FindIndex(x => x.Id == imageId);
        var targetIndex = currentIndex + offset;

        if (currentIndex < 0 || targetIndex < 0 || targetIndex >= orderedImages.Count)
            return;

        (orderedImages[currentIndex], orderedImages[targetIndex]) =
            (orderedImages[targetIndex], orderedImages[currentIndex]);

        for (var index = 0; index < orderedImages.Count; index++)
            orderedImages[index].SortOrder = index;

        SelectedImages = orderedImages;
        NormalizeSelectedImages();
    }

    private void NormalizeSelectedImages()
    {
        SelectedImages = SelectedImages
            .Where(x => !string.IsNullOrWhiteSpace(x.ImageUrl))
            .OrderBy(x => x.SortOrder)
            .ThenBy(x => x.Id)
            .ToList();

        var primary = SelectedImages.FirstOrDefault(x => x.IsPrimary) ?? SelectedImages.FirstOrDefault();

        for (var index = 0; index < SelectedImages.Count; index++)
        {
            SelectedImages[index].SortOrder = index;
            SelectedImages[index].IsPrimary = SelectedImages[index] == primary;
        }
    }

    private void ToggleDiscount(Guid discountId, object? value)
    {
        var isChecked = value is bool b && b;

        if (isChecked)
        {
            if (!SelectedDiscountIds.Contains(discountId))
                SelectedDiscountIds.Add(discountId);
        }
        else
        {
            SelectedDiscountIds.Remove(discountId);
        }
    }


    private void ToggleCategory(Guid categoryId, object? value)
    {
        var isChecked = value is bool b && b;

        if (isChecked)
        {
            if (!SelectedCategoryIds.Contains(categoryId))
                SelectedCategoryIds.Add(categoryId);
        }
        else
        {
            SelectedCategoryIds.Remove(categoryId);
        }
    }

    private async Task OnAdminCategoryFilterChanged(ChangeEventArgs e)
    {
        var rawValue = e.Value?.ToString();

        SelectedFilterCategoryId = Guid.TryParse(rawValue, out var categoryId)
            ? categoryId
            : Guid.Empty;

        await LoadProducts();
    }

    private string GetDiscountSummary(Discount discount)
    {
        var valueText = discount.ValueType == DiscountValueType.Percent
            ? $"{discount.Value}%"
            : $"₪{discount.Value}";

        return discount.RuleType switch
        {
            DiscountRuleType.ProductDirect => $"تخفيض مباشر {valueText}",
            DiscountRuleType.QuantityBased => $"بعد {discount.MinimumQuantity} قطع: {valueText}",
            DiscountRuleType.AmountBased => $"بعد ₪{discount.MinimumAmount}: {valueText}",
            DiscountRuleType.BundleFixedPrice => $"{discount.MinimumQuantity} قطع بسعر ₪{discount.BundleFixedTotalPrice}",
            DiscountRuleType.FixedSalePrice => $"سعر ثابت ₪{discount.Value}",
            _ => valueText
        };
    }

}
