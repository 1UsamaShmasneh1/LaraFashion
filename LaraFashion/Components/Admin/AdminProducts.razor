@page "/admin/products"

@using LaraFashion.Models
@using LaraFashion.Models.Enums
@using SkiaSharp

@inject IWebHostEnvironment WebHostEnvironment
@inject LaraFashion.Services.ProductService ProductService
@inject LaraFashion.Services.AdminAuthService AdminAuthService
@inject LaraFashion.Services.BrowserStorageService BrowserStorageService
@inject LaraFashion.Services.DiscountService DiscountService
@inject NavigationManager Navigation

<AdminNav />

<h1 class="admin-page-title">
    Products
</h1>

<button class="checkout-button admin-add-product-button"
        @onclick="OpenAddModal">
    Add Product
</button>

@if (IsLoading)
{
    <div class="empty-cart">
        Loading...
    </div>
}
else if (!Products.Any())
{
    <div class="empty-cart">
        No products found
    </div>
}
else
{
    <div class="products-grid">

        @foreach (var product in Products)
        {
            <div class="product-card">

                <div class="product-image-container">

                    @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                    {
                        <img src="@product.ImageUrl" class="product-image" />
                    }
                    else
                    {
                        <div class="product-image-placeholder">
                            No Image
                        </div>
                    }

                </div>

                <div class="product-content">

                    <div class="product-name">
                        @product.Name
                    </div>

                    <div class="product-serial">
                        SN: @product.SerialNumber
                    </div>

                    <div class="final-price">
                        ₪@product.FinalPrice
                    </div>

                    @if (product.ProductDiscounts.Any(x => x.Discount.IsActive))
                    {
                        <div class="product-card-discounts">
                            @foreach (var pd in product.ProductDiscounts.Where(x => x.Discount.IsActive))
                            {
                                <div class="product-card-discount">
                                    @GetDiscountSummary(pd.Discount)
                                </div>
                            }
                        </div>
                    }

                    <div style="display:flex; gap:10px; margin-top:15px;">
                        <button class="continue-shopping-button"
                                @onclick="(() => OpenEditModal(product))">
                            Edit
                        </button>

                        <button class="remove-item-button"
                                @onclick="(() => DeleteProduct(product.Id))">
                            Delete
                        </button>
                    </div>

                </div>

            </div>
        }

    </div>
}

@if (IsAddModalOpen)
{
    <div class="modal-overlay">

        <div class="checkout-modal" @onclick:stopPropagation="true">

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="checkout-error">
                    @ErrorMessage
                </div>
            }

            <h2>@(IsEditMode ? "Edit Product" : "Add Product")</h2>

            <div class="form-group">
                <label>Name</label>
                <input @bind="NewProduct.Name" />
            </div>

            <div class="form-group">
                <label>Serial Number</label>
                <input @bind="NewProduct.SerialNumber" />
            </div>

            <div class="form-group">
                <label>Description</label>
                <input @bind="NewProduct.Description" />
            </div>

            <div class="form-group">
                <label>Price</label>
                <input type="number"
                       @bind="NewProduct.OriginalPrice" />
            </div>

            <div class="form-group">
                <label>Discount Type</label>

                <select @bind="NewProduct.DiscountType"
                        class="form-select">

                    <option value="@DiscountType.None">None</option>
                    <option value="@DiscountType.Percent">Percent</option>
                    <option value="@DiscountType.FixedPrice">Fixed Price</option>

                </select>
            </div>

            <div class="form-group">
                <label>Discount Value</label>

                <input type="number"
                       @bind="NewProduct.DiscountValue" />
            </div>

            <div class="form-group">
                <label>Image</label>

                <InputFile OnChange="OnImageSelected" />
            </div>

            <h3>التخفيضات المتاحة</h3>

            @if (!AvailableDiscounts.Any())
            {
                <div class="delivery-price-note">
                    لا توجد تخفيضات فعالة حالياً
                </div>
            }
            else
            {
                <div class="discount-select-list">
                    @foreach (var discount in AvailableDiscounts)
                    {
                        <label class="discount-check-row">
                            <input type="checkbox"
                                   checked="@SelectedDiscountIds.Contains(discount.Id)"
                                   @onchange="e => ToggleDiscount(discount.Id, e.Value)" />

                            <span>
                                @discount.Name -
                                @GetDiscountSummary(discount)
                            </span>
                        </label>
                    }
                </div>
            }

            <h3>Sizes</h3>

            @foreach (var size in NewProduct.Sizes)
            {
                <div class="size-admin-row">

                    <input placeholder="Size"
                           @bind="size.SizeName" />

                    <input type="number"
                           placeholder="Quantity"
                           @bind="size.Quantity" />

                </div>
            }

            <button type="button"
                    class="continue-shopping-button mb-3"
                    @onclick="AddSize">
                Add Size
            </button>

            <div class="checkout-buttons">

                <button type="button"
                        class="continue-shopping-button"
                        @onclick="CloseAddModal">
                    Cancel
                </button>

                <button type="button"
                        class="checkout-button"
                        disabled="@IsSaving"
                        @onclick="SaveProduct">
                    @(IsSaving ? "Saving..." : IsEditMode ? "Update Product" : "Save Product")
                </button>

            </div>

        </div>

    </div>
}

@code {

    private bool IsLoading = true;

    private bool IsAddModalOpen;

    private bool IsEditMode;

    private string ErrorMessage = string.Empty;
    
    private bool IsSaving;

    private List<Product> Products = new();

    private Product NewProduct = new();

    private List<Discount> AvailableDiscounts = new();

    private List<Guid> SelectedDiscountIds = new();

    private Guid EditingProductId = Guid.Empty;

    private string? SelectedImageUrl;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var token =
            await BrowserStorageService.GetItemAsync("admin_token");

        if (string.IsNullOrWhiteSpace(token) ||
            !AdminAuthService.IsTokenValid(token))
        {
            Navigation.NavigateTo("/admin/login");
            return;
        }

        await LoadProducts();

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadProducts()
    {
        Products = await ProductService.GetAllProductsAsync();
        AvailableDiscounts = await DiscountService.GetActiveAsync();

        IsLoading = false;
    }

    private void OpenAddModal()
    {
        IsEditMode = false;
        SelectedDiscountIds = new();
        EditingProductId = Guid.Empty;
        SelectedImageUrl = null;

        NewProduct = new Product
        {
            Sizes = new()
        };

        IsAddModalOpen = true;
    }

    private void CloseAddModal()
    {
        IsAddModalOpen = false;
        IsEditMode = false;
        NewProduct = new Product();

        StateHasChanged();
    }

    private void AddSize()
    {
        NewProduct.Sizes.Add(new ProductSize());
    }

    private async Task SaveProduct()
    {
        if (IsSaving)
            return;

        try
        {
            IsSaving = true;
            ErrorMessage = string.Empty;

            if (IsEditMode)
            {
                if (EditingProductId == Guid.Empty)
                {
                    ErrorMessage = "خطأ: رقم المنتج مفقود، لا يمكن التعديل.";
                    return;
                }

                NewProduct.Id = EditingProductId;

                if (!string.IsNullOrWhiteSpace(SelectedImageUrl))
                {
                    NewProduct.ImageUrl = SelectedImageUrl;
                }

                Console.WriteLine($"SAVE IMAGE URL: {NewProduct.ImageUrl}");

                await ProductService.UpdateProductWithSizesAsync(NewProduct);
                await ProductService.UpdateProductDiscountsAsync(EditingProductId, SelectedDiscountIds);
            }
            else
            {
                if (NewProduct.Id != Guid.Empty)
                {
                    ErrorMessage = "خطأ: المنتج يبدو كمنتج تعديل وليس منتج جديد.";
                    return;
                }

                await ProductService.AddProductAsync(NewProduct);
                await ProductService.UpdateProductDiscountsAsync(NewProduct.Id, SelectedDiscountIds);
            }

            IsAddModalOpen = false;
            IsEditMode = false;
            EditingProductId = Guid.Empty;
            NewProduct = new Product();
            SelectedDiscountIds = new();

            await LoadProducts();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsSaving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OpenEditModal(Product product)
    {
        IsEditMode = true;

        EditingProductId = product.Id;

        SelectedImageUrl = product.ImageUrl;

        SelectedDiscountIds = product.ProductDiscounts
    .Select(x => x.DiscountId)
    .ToList();

        NewProduct = new Product
        {
            Id = product.Id,
            Name = product.Name,
            SerialNumber = product.SerialNumber,
            Description = product.Description,
            OriginalPrice = product.OriginalPrice,
            DiscountType = product.DiscountType,
            DiscountValue = product.DiscountValue,
            ImageUrl = product.ImageUrl,
            IsActive = product.IsActive,
            Sizes = product.Sizes.Select(x => new ProductSize
            {
                Id = x.Id,
                ProductId = x.ProductId,
                SizeName = x.SizeName,
                Quantity = x.Quantity
            }).ToList()
        };

        IsAddModalOpen = true;
    }

    private async Task DeleteProduct(Guid id)
    {
        await ProductService.DeleteProductAsync(id);

        await LoadProducts();
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        try
        {
            Console.WriteLine("ON IMAGE SELECTED STARTED");

            var file = e.File;

            var uploadsFolder = "/var/www/larafashion/uploads";
            Directory.CreateDirectory(uploadsFolder);

            var extension = Path.GetExtension(file.Name);
            if (string.IsNullOrWhiteSpace(extension))
                extension = ".jpg";

            var fileName = $"{Guid.NewGuid()}{extension}";
            var fullPath = Path.Combine(uploadsFolder, fileName);

            await using var inputStream = file.OpenReadStream(10 * 1024 * 1024);
            await using var fileStream = File.Create(fullPath);

            await inputStream.CopyToAsync(fileStream);

            SelectedImageUrl = $"/uploads/{fileName}";
            NewProduct.ImageUrl = SelectedImageUrl;

            Console.WriteLine($"IMAGE SAVED TO: {fullPath}");
            Console.WriteLine($"IMAGE URL: {NewProduct.ImageUrl}");
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Image upload error: {ex.Message}";
            Console.WriteLine(ex.ToString());
        }
    }

    private void ToggleDiscount(Guid discountId, object? value)
    {
        var isChecked = value is bool b && b;

        if (isChecked)
        {
            if (!SelectedDiscountIds.Contains(discountId))
                SelectedDiscountIds.Add(discountId);
        }
        else
        {
            SelectedDiscountIds.Remove(discountId);
        }
    }

    private string GetDiscountSummary(Discount discount)
    {
        var valueText = discount.ValueType == DiscountValueType.Percent
            ? $"{discount.Value}%"
            : $"₪{discount.Value}";

        return discount.RuleType switch
        {
            DiscountRuleType.ProductDirect => $"تخفيض مباشر {valueText}",
            DiscountRuleType.QuantityBased => $"بعد {discount.MinimumQuantity} قطع: {valueText}",
            DiscountRuleType.AmountBased => $"بعد ₪{discount.MinimumAmount}: {valueText}",
            DiscountRuleType.BundleFixedPrice => $"{discount.MinimumQuantity} قطع بسعر ₪{discount.BundleFixedTotalPrice}",
            _ => valueText
        };
    }

}