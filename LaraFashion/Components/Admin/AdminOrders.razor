@page "/admin/orders"

@using System.Globalization
@using LaraFashion.Models
@using LaraFashion.Models.Enums
@using LaraFashion.Services
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop

@inject OrderService OrderService
@inject AdminAuthService AdminAuthService
@inject BrowserStorageService BrowserStorageService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<AdminNav />

<PageTitle>Orders</PageTitle>

@if (IsCheckingAuth)
{
    <div class="empty-cart">Checking admin access...</div>
    return;
}

<button class="logout-button" @onclick="Logout">تسجيل الخروج</button>

<h2 class="mb-4">الطلبات</h2>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="checkout-error">@ErrorMessage</div>
}

@if (!string.IsNullOrWhiteSpace(SuccessMessage))
{
    <div class="lf-orders-success">@SuccessMessage</div>
}

<div class="lf-orders-toolbar" dir="rtl">
    <div class="lf-orders-view-switch" aria-label="طريقة عرض الطلبات">
        <button type="button"
                class="lf-orders-view-button @(viewMode == OrderViewMode.Cards ? "is-active" : string.Empty)"
                aria-pressed="@(viewMode == OrderViewMode.Cards)"
                @onclick="() => ChangeViewMode(OrderViewMode.Cards)">
            عرض كبطاقات
        </button>
        <button type="button"
                class="lf-orders-view-button @(viewMode == OrderViewMode.Table ? "is-active" : string.Empty)"
                aria-pressed="@(viewMode == OrderViewMode.Table)"
                @onclick="() => ChangeViewMode(OrderViewMode.Table)">
            عرض كجدول
        </button>
    </div>

    @if (orders.Count > 0)
    {
        <label class="lf-orders-select-all">
            <input type="checkbox"
                   checked="@AreAllVisibleSelected"
                   @onchange="ToggleAllVisible" />
            <span>تحديد كل الطلبات الظاهرة</span>
        </label>
    }
</div>

@if (selectedOrderIds.Count > 0)
{
    <section class="lf-orders-bulk-bar" dir="rtl" aria-label="إجراءات الطلبات المحددة">
        <strong>تم تحديد @selectedOrderIds.Count طلبيات</strong>

        <div class="lf-orders-selection-actions">
            <button type="button" @onclick="SelectAllVisible">تحديد كل الطلبات الظاهرة</button>
            @if (TryGetSingleSelectedStatus(out var commonStatus))
            {
                <button type="button" @onclick="() => SelectAllWithStatus(commonStatus)">
                    تحديد جميع الطلبات بالحالة "@GetStatusText(commonStatus)"
                </button>
            }
            <button type="button" @onclick="ClearSelection">إلغاء التحديد</button>
        </div>

        <div class="lf-orders-bulk-status">
            <label for="bulk-order-status">الحالة الجديدة</label>
            <select id="bulk-order-status" value="@bulkStatus" @onchange="OnBulkStatusChanged">
                @foreach (var status in Enum.GetValues<OrderStatus>())
                {
                    <option value="@status">@GetStatusText(status)</option>
                }
            </select>
            <button type="button"
                    class="lf-orders-apply-status"
                    disabled="@IsBulkUpdating"
                    @onclick="ShowBulkConfirmation">
                @(IsBulkUpdating ? "جاري التطبيق..." : "تطبيق الحالة")
            </button>
        </div>
    </section>
}

@if (orders.Count == 0)
{
    <div class="empty-cart-card">
        <p>لا توجد طلبات بعد</p>
    </div>
}
else if (viewMode == OrderViewMode.Cards)
{
    <div class="orders-grid lf-orders-cards" dir="rtl">
        @foreach (var order in displayedOrders)
        {
            <div class="order-card lf-orders-card"
                 @key="order.Id"
                 role="button"
                 tabindex="0"
                 @onclick="() => OpenOrder(order.Id)"
                 @onkeydown="e => HandleOrderKeyDown(e, order.Id)">
                <label class="lf-orders-card-checkbox" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                    <input type="checkbox"
                           aria-label="تحديد الطلب @order.OrderNumber"
                           checked="@selectedOrderIds.Contains(order.Id)"
                           @onchange="e => SetOrderSelection(order.Id, IsChecked(e))" />
                </label>

                <div class="order-header">
                    <h4>@order.OrderNumber</h4>
                    <span class="status-badge @GetStatusCssClass(order.Status)">@GetStatusText(order.Status)</span>
                </div>

                <div class="order-info">
                    <p><strong>الزبون:</strong> @order.Customer.FullName</p>
                    <p><strong>الهاتف:</strong> @order.Customer.PhoneNumber</p>
                    <p><strong>المجموع:</strong> ₪@GetOrderTotal(order)</p>
                    <p><strong>المنتجات:</strong> @order.Items.Count</p>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="lf-orders-table-container" dir="rtl">
        <table class="lf-orders-table">
            <thead>
                <tr>
                    <th class="lf-orders-checkbox-column">
                        <input type="checkbox"
                               aria-label="تحديد كل الطلبات الظاهرة"
                               checked="@AreAllVisibleSelected"
                               @onchange="ToggleAllVisible" />
                    </th>
                    <th><button type="button" class="lf-orders-sort-button" @onclick="() => CycleSort(OrderSortColumn.OrderNumber)">رقم الطلب <span aria-hidden="true">@GetSortIndicator(OrderSortColumn.OrderNumber)</span></button></th>
                    <th><button type="button" class="lf-orders-sort-button" @onclick="() => CycleSort(OrderSortColumn.CustomerName)">اسم الزبون <span aria-hidden="true">@GetSortIndicator(OrderSortColumn.CustomerName)</span></button></th>
                    <th><button type="button" class="lf-orders-sort-button" @onclick="() => CycleSort(OrderSortColumn.Phone)">الهاتف <span aria-hidden="true">@GetSortIndicator(OrderSortColumn.Phone)</span></button></th>
                    <th><button type="button" class="lf-orders-sort-button" @onclick="() => CycleSort(OrderSortColumn.CreatedAt)">تاريخ الطلب <span aria-hidden="true">@GetSortIndicator(OrderSortColumn.CreatedAt)</span></button></th>
                    <th><button type="button" class="lf-orders-sort-button" @onclick="() => CycleSort(OrderSortColumn.UpdatedAt)">آخر تعديل <span aria-hidden="true">@GetSortIndicator(OrderSortColumn.UpdatedAt)</span></button></th>
                    <th><button type="button" class="lf-orders-sort-button" @onclick="() => CycleSort(OrderSortColumn.ItemCount)">عدد المنتجات <span aria-hidden="true">@GetSortIndicator(OrderSortColumn.ItemCount)</span></button></th>
                    <th><button type="button" class="lf-orders-sort-button" @onclick="() => CycleSort(OrderSortColumn.Total)">المجموع <span aria-hidden="true">@GetSortIndicator(OrderSortColumn.Total)</span></button></th>
                    <th><button type="button" class="lf-orders-sort-button" @onclick="() => CycleSort(OrderSortColumn.Status)">الحالة <span aria-hidden="true">@GetSortIndicator(OrderSortColumn.Status)</span></button></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in displayedOrders)
                {
                    <tr @key="order.Id"
                        role="button"
                        tabindex="0"
                        @onclick="() => OpenOrder(order.Id)"
                        @onkeydown="e => HandleOrderKeyDown(e, order.Id)">
                        <td class="lf-orders-checkbox-column" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                            <input type="checkbox"
                                   aria-label="تحديد الطلب @order.OrderNumber"
                                   checked="@selectedOrderIds.Contains(order.Id)"
                                   @onchange="e => SetOrderSelection(order.Id, IsChecked(e))" />
                        </td>
                        <td class="lf-orders-nowrap"><strong>@order.OrderNumber</strong></td>
                        <td>@order.Customer.FullName</td>
                        <td class="lf-orders-nowrap">@order.Customer.PhoneNumber</td>
                        <td class="lf-orders-nowrap">@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="lf-orders-nowrap">@order.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@order.Items.Count</td>
                        <td class="lf-orders-nowrap">₪@GetOrderTotal(order)</td>
                        <td class="lf-orders-nowrap">
                            <span class="status-badge @GetStatusCssClass(order.Status)">@GetStatusText(order.Status)</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (IsBulkConfirmationVisible)
{
    <div class="modal-overlay lf-orders-confirm-overlay" role="presentation">
        <div class="lf-orders-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="bulk-confirm-title" dir="rtl">
            <h2 id="bulk-confirm-title">تأكيد تغيير حالة الطلبات</h2>
            <p>سيتم تغيير حالة <strong>@selectedOrderIds.Count</strong> طلباً إلى <strong>"@GetStatusText(bulkStatus)"</strong>.</p>
            <p class="lf-orders-confirm-warning">هذه العملية ستغيّر حالة عدة طلبات وتطبّق قواعد المخزون وسجل المبيعات الحالية.</p>
            <div class="lf-orders-confirm-actions">
                <button type="button" class="lf-orders-confirm-button" disabled="@IsBulkUpdating" @onclick="ConfirmBulkStatusUpdate">تأكيد</button>
                <button type="button" disabled="@IsBulkUpdating" @onclick="CancelBulkConfirmation">إلغاء</button>
            </div>
        </div>
    </div>
}

@if (selectedOrder is not null)
{
    <div class="modal-overlay">
        <div class="order-modal">
            <button class="close-btn" @onclick="CloseModal">×</button>

            <h2>@selectedOrder.OrderNumber</h2>

            <div class="lf-order-status-card" dir="rtl" style="padding:22px;border-radius:26px;background:linear-gradient(135deg,#ffffff,#f8fafc);border:1px solid #e2e8f0;box-shadow:0 14px 34px rgba(15,23,42,.10);margin:18px 0 24px;display:flex;flex-direction:column;gap:16px;">
                <div class="lf-order-status-top" style="display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;">
                    <div class="lf-order-status-title" style="display:flex;flex-direction:column;gap:8px;text-align:right;color:#334155;font-weight:950;">
                        <span>حالة الطلبية</span>
                        <strong>@GetStatusText(selectedStatus)</strong>
                    </div>

                    <span class="status-badge lf-status-pill @GetStatusCssClass(selectedStatus)" style="display:inline-flex;align-items:center;justify-content:center;width:max-content;border-radius:999px;padding:10px 18px;background:#ede9fe;color:#6d28d9;font-size:15px;font-weight:950;">
                        @GetStatusText(selectedStatus)
                    </span>
                </div>

                <div class="lf-order-status-actions" style="display:grid;grid-template-columns:minmax(220px,1fr) auto;gap:12px;align-items:center;">
                    <div class="lf-select-wrap lf-status-wrap" style="position:relative;min-width:190px;">
                        <select class="lf-modern-select lf-status-select" style="width:100%;height:54px;border:0;border-radius:18px;padding:0 46px 0 18px;color:#111827;background:linear-gradient(135deg,#e0f2fe,#ede9fe);font-size:16px;font-weight:950;box-shadow:0 12px 24px rgba(124,58,237,.22), inset 0 1px 0 rgba(255,255,255,.25);outline:none;appearance:none;-webkit-appearance:none;cursor:pointer;text-align:center;"
                                value="@selectedStatus"
                                @onchange="OnSelectedStatusChanged">
                            @foreach (var status in Enum.GetValues<OrderStatus>())
                            {
                                <option style="color:#111827;background:white;" value="@status">@GetStatusText(status)</option>
                            }
                        </select>
                    </div>

                    <button type="button" class="lf-save-status-btn" @onclick="SaveStatus" style="height:54px;border:0;border-radius:18px;padding:0 26px;color:white;background:linear-gradient(135deg,#22c55e,#16a34a);font-size:17px;font-weight:950;cursor:pointer;box-shadow:0 12px 24px rgba(34,197,94,.22);white-space:nowrap;">
                        حفظ الحالة
                    </button>
                </div>

                @if (CanDeleteSelectedOrder)
                {
                    <button type="button" class="delete-order-btn lf-delete-order-btn" @onclick="DeleteSelectedOrder" style="width:max-content;border:0;border-radius:18px;padding:13px 20px;color:white;background:linear-gradient(135deg,#ef4444,#dc2626);font-size:16px;font-weight:950;cursor:pointer;box-shadow:0 12px 24px rgba(239,68,68,.22);">
                        حذف الطلبية نهائياً
                    </button>
                }
                else
                {
                    <div class="delete-order-hint lf-delete-order-hint">
                        يمكن حذف الطلبية فقط إذا كانت بحالة ملغاة أو جاهز.
                    </div>
                }
            </div>

            <p><strong>تم الإنشاء:</strong> @selectedOrder.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
            <p><strong>آخر تحديث:</strong> @selectedOrder.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</p>

            <hr />

            <h3>معلومات الزبون</h3>

            <p><strong>الاسم:</strong> @selectedOrder.Customer.FullName</p>
            <p>
                <strong>الهاتف:</strong> @selectedOrder.Customer.PhoneNumber

                @if (!string.IsNullOrWhiteSpace(GetWhatsAppLink(selectedOrder.Customer.PhoneNumber)))
                {
                    <a class="whatsapp-button" href="@GetWhatsAppLink(selectedOrder.Customer.PhoneNumber)" target="_blank">
                        WhatsApp
                    </a>
                }
            </p>
            <p><strong>المدينة:</strong> @selectedOrder.Customer.City</p>
            <p><strong>الشارع:</strong> @selectedOrder.Customer.Street</p>
            <p><strong>رقم المنزل:</strong> @selectedOrder.Customer.HouseNumber</p>

            <hr />

            <h3>المنتجات</h3>

            @foreach (var item in selectedOrder.Items)
            {
                <div class="product-row">
                    <img src="@item.ProductImageUrl" class="admin-order-item-image" />

                    <div>
                        <h4>@item.ProductName</h4>
                        <p>SN: @item.ProductSerialNumber</p>
                        <p>المقاس: @item.Size</p>
                        <p>الكمية: @item.Quantity</p>
                        <p>سعر الوحدة: ₪@item.UnitPrice</p>
                        <p>المجموع: ₪@item.TotalPrice</p>
                    </div>
                </div>
            }

            <div>السعر قبل التخفيض: ₪@selectedOrder.OriginalTotal</div>

            @if (selectedOrder.DiscountAmount > 0)
            {
                <div class="discount-summary">
                    قيمة التخفيض: ₪@selectedOrder.DiscountAmount
                </div>
            }

            <div><strong>المجموع النهائي: ₪@selectedOrder.FinalTotal</strong></div>
        </div>
    </div>
}

@code {
    private const string ViewModeStorageKey = "larafashion.admin.orders.viewMode";
    private bool IsCheckingAuth = true;
    private bool IsBulkUpdating;
    private bool IsBulkConfirmationVisible;
    private string ErrorMessage = string.Empty;
    private string SuccessMessage = string.Empty;
    private string adminToken = string.Empty;

    private List<Order> orders = new();
    private List<Order> displayedOrders = new();
    private readonly HashSet<Guid> selectedOrderIds = new();
    private Order? selectedOrder;
    private OrderStatus selectedStatus;
    private OrderStatus bulkStatus;
    private OrderViewMode viewMode = OrderViewMode.Cards;
    private OrderSortColumn? sortColumn;
    private SortDirection sortDirection = SortDirection.None;

    private bool CanDeleteSelectedOrder =>
        selectedOrder is not null &&
        (selectedOrder.Status == OrderStatus.Cancelled || selectedOrder.Status == OrderStatus.Ready);

    private bool AreAllVisibleSelected =>
        displayedOrders.Count > 0 && displayedOrders.All(x => selectedOrderIds.Contains(x.Id));

    private async Task OpenOrder(Guid id)
    {
        ErrorMessage = string.Empty;
        selectedOrder = await OrderService.GetOrderAsync(id);

        if (selectedOrder is not null)
            selectedStatus = selectedOrder.Status;
    }

    private Task HandleOrderKeyDown(KeyboardEventArgs e, Guid id)
    {
        return e.Key is "Enter" or " " ? OpenOrder(id) : Task.CompletedTask;
    }

    private void CloseModal()
    {
        selectedOrder = null;
    }

    private void OnSelectedStatusChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<OrderStatus>(e.Value?.ToString(), out var status))
            selectedStatus = status;
    }

    private void OnBulkStatusChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<OrderStatus>(e.Value?.ToString(), out var status))
            bulkStatus = status;
    }

    private async Task SaveStatus()
    {
        if (selectedOrder is null)
            return;

        try
        {
            ClearMessages();
            await OrderService.UpdateStatusAsync(selectedOrder.Id, selectedStatus);
            await LoadOrdersAsync();
            selectedOrder = await OrderService.GetOrderAsync(selectedOrder.Id);
            SuccessMessage = "تم حفظ حالة الطلبية.";
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private async Task DeleteSelectedOrder()
    {
        if (selectedOrder is null)
            return;

        var confirmed = await JS.InvokeAsync<bool>("confirm", "هل أنت متأكد من حذف الطلبية نهائياً؟ لا يمكن التراجع عن هذه العملية.");

        if (!confirmed)
            return;

        try
        {
            ClearMessages();
            var orderId = selectedOrder.Id;
            await OrderService.DeleteOrderAsync(orderId);
            selectedOrder = null;
            await LoadOrdersAsync();
            SuccessMessage = "تم حذف الطلبية نهائياً.";
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private async Task ChangeViewMode(OrderViewMode mode)
    {
        if (viewMode == mode)
            return;

        viewMode = mode;
        ResetSorting();
        await BrowserStorageService.SetItemAsync(ViewModeStorageKey, mode == OrderViewMode.Table ? "table" : "cards");
    }

    private void CycleSort(OrderSortColumn column)
    {
        if (sortColumn != column)
        {
            sortColumn = column;
            sortDirection = SortDirection.Ascending;
        }
        else
        {
            sortDirection = sortDirection switch
            {
                SortDirection.Ascending => SortDirection.Descending,
                SortDirection.Descending => SortDirection.None,
                _ => SortDirection.Ascending
            };

            if (sortDirection == SortDirection.None)
                sortColumn = null;
        }

        ApplySorting();
    }

    private void ApplySorting()
    {
        if (sortColumn is null || sortDirection == SortDirection.None)
        {
            displayedOrders = orders.ToList();
            return;
        }

        Func<Order, object?> selector = sortColumn.Value switch
        {
            OrderSortColumn.OrderNumber => x => x.OrderNumber,
            OrderSortColumn.CustomerName => x => x.Customer.FullName,
            OrderSortColumn.Phone => x => x.Customer.PhoneNumber,
            OrderSortColumn.CreatedAt => x => x.CreatedAt,
            OrderSortColumn.UpdatedAt => x => x.UpdatedAt,
            OrderSortColumn.ItemCount => x => x.Items.Count,
            OrderSortColumn.Total => x => GetOrderTotal(x),
            OrderSortColumn.Status => x => GetStatusText(x.Status),
            _ => x => x.CreatedAt
        };

        var comparer = ObjectSortComparer.Instance;
        displayedOrders = sortDirection == SortDirection.Ascending
            ? orders.OrderBy(selector, comparer).ToList()
            : orders.OrderByDescending(selector, comparer).ToList();
    }

    private void ResetSorting()
    {
        sortColumn = null;
        sortDirection = SortDirection.None;
        displayedOrders = orders.ToList();
    }

    private string GetSortIndicator(OrderSortColumn column)
    {
        if (sortColumn != column)
            return "↕";

        return sortDirection switch
        {
            SortDirection.Ascending => "↑",
            SortDirection.Descending => "↓",
            _ => "↕"
        };
    }

    private static bool IsChecked(ChangeEventArgs e) => e.Value is bool value && value;

    private void SetOrderSelection(Guid id, bool isSelected)
    {
        if (isSelected)
        {
            var wasEmpty = selectedOrderIds.Count == 0;
            selectedOrderIds.Add(id);
            if (wasEmpty)
            {
                var order = orders.FirstOrDefault(x => x.Id == id);
                if (order is not null)
                    bulkStatus = order.Status;
            }
        }
        else
        {
            selectedOrderIds.Remove(id);
        }
    }

    private void ToggleAllVisible(ChangeEventArgs e)
    {
        if (IsChecked(e))
            SelectAllVisible();
        else
            ClearVisibleSelection();
    }

    private void SelectAllVisible()
    {
        foreach (var order in displayedOrders)
            selectedOrderIds.Add(order.Id);
    }

    private void ClearVisibleSelection()
    {
        foreach (var order in displayedOrders)
            selectedOrderIds.Remove(order.Id);
    }

    private void ClearSelection()
    {
        selectedOrderIds.Clear();
    }

    private bool TryGetSingleSelectedStatus(out OrderStatus status)
    {
        var statuses = orders
            .Where(x => selectedOrderIds.Contains(x.Id))
            .Select(x => x.Status)
            .Distinct()
            .Take(2)
            .ToList();

        status = statuses.FirstOrDefault();
        return statuses.Count == 1;
    }

    private void SelectAllWithStatus(OrderStatus status)
    {
        foreach (var order in orders.Where(x => x.Status == status))
            selectedOrderIds.Add(order.Id);
    }

    private void ShowBulkConfirmation()
    {
        if (selectedOrderIds.Count > 0)
            IsBulkConfirmationVisible = true;
    }

    private void CancelBulkConfirmation()
    {
        if (!IsBulkUpdating)
            IsBulkConfirmationVisible = false;
    }

    private async Task ConfirmBulkStatusUpdate()
    {
        if (selectedOrderIds.Count == 0 || IsBulkUpdating)
            return;

        try
        {
            IsBulkUpdating = true;
            ClearMessages();
            var result = await OrderService.UpdateStatusesAsync(selectedOrderIds, bulkStatus, adminToken);
            IsBulkConfirmationVisible = false;
            selectedOrderIds.Clear();
            await LoadOrdersAsync();
            SuccessMessage = $"تم تحديث حالة {result.UpdatedOrders} طلبيات بنجاح.";
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsBulkUpdating = false;
        }
    }

    private async Task LoadOrdersAsync()
    {
        orders = await OrderService.GetOrdersAsync();
        selectedOrderIds.IntersectWith(orders.Select(x => x.Id));
        ResetSorting();
    }

    private void ClearMessages()
    {
        ErrorMessage = string.Empty;
        SuccessMessage = string.Empty;
    }

    private static decimal GetOrderTotal(Order order) =>
        order.FinalTotal > 0 ? order.FinalTotal : order.TotalPrice;

    private string GetStatusText(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.New => "جديد",
            OrderStatus.Preparing => "قيد التحضير",
            OrderStatus.Ready => "جاهز",
            OrderStatus.Shipped => "تم الإرسال",
            OrderStatus.Cancelled => "ملغاة",
            _ => status.ToString()
        };
    }

    private string GetStatusCssClass(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.New => "status-new",
            OrderStatus.Preparing => "status-preparing",
            OrderStatus.Ready => "status-ready",
            OrderStatus.Shipped => "status-shipped",
            OrderStatus.Cancelled => "status-cancelled",
            _ => string.Empty
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        adminToken = await BrowserStorageService.GetItemAsync("admin_token") ?? string.Empty;

        if (string.IsNullOrWhiteSpace(adminToken) || !AdminAuthService.IsTokenValid(adminToken))
        {
            Navigation.NavigateTo("/admin/login");
            return;
        }

        var storedViewMode = await BrowserStorageService.GetItemAsync(ViewModeStorageKey);
        viewMode = storedViewMode == "table" ? OrderViewMode.Table : OrderViewMode.Cards;
        IsCheckingAuth = false;
        await LoadOrdersAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task Logout()
    {
        await BrowserStorageService.RemoveItemAsync("admin_token");
        Navigation.NavigateTo("/admin/login");
    }

    private string GetWhatsAppLink(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone))
            return string.Empty;

        var digits = new string(phone.Where(char.IsDigit).ToArray());

        if (digits.StartsWith("00"))
            digits = digits[2..];

        if (digits.StartsWith("972"))
            return $"https://wa.me/{digits}";

        if (digits.StartsWith("0") && digits.Length >= 9)
            return $"https://wa.me/972{digits[1..]}";

        if (digits.Length >= 9)
            return $"https://wa.me/{digits}";

        return string.Empty;
    }

