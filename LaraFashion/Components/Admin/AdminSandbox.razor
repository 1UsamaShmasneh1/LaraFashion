@page "/admin/sandbox"

@using LaraFashion.Models
@using LaraFashion.Services
@using LaraFashion.Components.Store
@using LaraFashion.Components.Modals

@inject ProductService ProductService
@inject CategoryService CategoryService
@inject AdminAuthService AdminAuthService
@inject BrowserStorageService BrowserStorageService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<AdminNav />

<PageTitle>Sandbox</PageTitle>

@if (IsCheckingAuth)
{
    <div class="empty-cart">Checking admin access...</div>
    return;
}

<h1 class="admin-page-title">
    متجر Sandbox
</h1>

@if (!string.IsNullOrWhiteSpace(SuccessMessage))
{
    <div class="settings-success sandbox-success" dir="rtl">
        @SuccessMessage
    </div>
}

<div class="category-button-bar store-category-filter" dir="rtl">
    <button type="button"
            class="category-filter-button @(SelectedCategoryId == Guid.Empty ? "active" : string.Empty)"
            @onclick="(() => SelectSandboxCategory(Guid.Empty))">
        كل المنتجات
    </button>

    @foreach (var category in Categories)
    {
        <button type="button"
                class="category-filter-button @(SelectedCategoryId == category.Id ? "active" : string.Empty)"
                @onclick="(() => SelectSandboxCategory(category.Id))">
            @category.Name
        </button>
    }
</div>

@if (Products.Any())
{
    <div class="sandbox-top-actions" dir="rtl">
        <button type="button"
                class="checkout-button"
                disabled="@IsPublishingAll"
                @onclick="PublishAllProducts">
            @(IsPublishingAll ? "جاري النشر..." : "نشر جميع المنتجات")
        </button>
    </div>
}

@if (IsLoading)
{
    <div class="empty-cart">
        جاري تحميل منتجات Sandbox...
    </div>
}
else if (!Products.Any())
{
    <div class="empty-cart" dir="rtl">
        لا توجد منتجات غير منشورة حالياً في متجر Sandbox.
    </div>
}
else
{
    <div class="products-grid sandbox-products-grid">
        @foreach (var product in Products)
        {
            <div class="sandbox-product-shell">
                <div @onclick="(() => OpenProduct(product))">
                    <ProductCard Product="product" />
                </div>

                <div class="sandbox-card-actions" dir="rtl">
                    <span class="sandbox-status-badge">Sandbox</span>
                    <button type="button"
                            class="checkout-button sandbox-publish-button"
                            @onclick="(() => PublishProduct(product.Id))"
                            @onclick:stopPropagation="true">
                        نشر المنتج
                    </button>
                </div>
            </div>
        }
    </div>
}

<ProductModal IsOpen="IsModalOpen"
              Product="SelectedProduct"
              AllowUnpublishedAdd="true"
              ShowUnpublishedNotice="true"
              AddToCartButtonText="إضافة إلى السلة"
              OnClose="CloseModal" />

<style>
    .sandbox-top-actions {
        display: flex;
        justify-content: flex-start;
        margin: 12px 0 22px;
    }

    .sandbox-product-shell {
        position: relative;
    }

    .sandbox-card-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-top: 10px;
        padding: 10px;
        background: white;
        border-radius: 16px;
        box-shadow: 0 5px 18px rgba(0,0,0,0.08);
    }

    .sandbox-status-badge {
        display: inline-flex;
        width: max-content;
        padding: 7px 12px;
        border-radius: 999px;
        background: #fff7ed;
        color: #9a3412;
        font-weight: 950;
        font-size: 13px;
    }

    .sandbox-publish-button {
        padding: 10px 18px;
        border-radius: 12px;
        font-size: 14px;
    }

    .sandbox-success {
        max-width: 680px;
        padding: 14px 18px;
        margin: 14px 0;
        border-radius: 18px;
        background: #dcfce7;
        color: #166534;
        font-weight: 900;
    }

    @@media (max-width: 700px) {
        .sandbox-card-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .sandbox-publish-button {
            width: 100%;
        }
    }
</style>

@code {
    private bool IsCheckingAuth = true;
    private bool IsLoading = true;
    private bool IsModalOpen;
    private bool IsPublishingAll;
    private string SuccessMessage = string.Empty;
    private Product SelectedProduct = new();
    private List<Product> Products = new();
    private List<Category> Categories = new();
    private Guid SelectedCategoryId = Guid.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var token = await BrowserStorageService.GetItemAsync("admin_token");

        if (string.IsNullOrWhiteSpace(token) || !AdminAuthService.IsTokenValid(token))
        {
            Navigation.NavigateTo("/admin/login");
            return;
        }

        IsCheckingAuth = false;
        Categories = await CategoryService.GetActiveAsync();
        await LoadProducts();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadProducts()
    {
        IsLoading = true;
        Products = await ProductService.GetUnpublishedProductsAsync(SelectedCategoryId == Guid.Empty ? null : SelectedCategoryId);
        IsLoading = false;
    }

    private async Task SelectSandboxCategory(Guid categoryId)
    {
        SelectedCategoryId = categoryId;
        SuccessMessage = string.Empty;
        await LoadProducts();
    }

    private void OpenProduct(Product product)
    {
        SelectedProduct = product;
        IsModalOpen = true;
    }

    private Task CloseModal()
    {
        IsModalOpen = false;
        return Task.CompletedTask;
    }

    private async Task PublishProduct(Guid productId)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "هل تريد نشر هذا المنتج الآن؟ سيتم نقله إلى المتجر الرسمي إذا كان متوفراً بالمخزون.");

        if (!confirmed)
            return;

        await ProductService.PublishProductAsync(productId);
        Products.RemoveAll(x => x.Id == productId);
        SuccessMessage = "تم نشر المنتج بنجاح.";
    }

    private async Task PublishAllProducts()
    {
        if (!Products.Any())
            return;

        var count = Products.Count;
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"هل تريد نشر جميع المنتجات غير المنشورة؟ سيتم نشر {count} منتج.");

        if (!confirmed)
            return;

        try
        {
            IsPublishingAll = true;
            var publishedCount = await ProductService.PublishAllUnpublishedProductsAsync();
            SuccessMessage = $"تم نشر {publishedCount} منتج بنجاح.";
            await LoadProducts();
        }
        finally
        {
            IsPublishingAll = false;
        }
    }
}
