@using LaraFashion.Services
@inject ReportsService ReportsService

<section class="report-panel analytics-card" aria-busy="@loading">
    <header class="analytics-header">
        <div><h2>@Title</h2><p>@Description</p></div>
        <div class="chart-controls">
            <label>التجميع<select value="@period" @onchange="ChangePeriod">@if (Tab == "visits") { <option value="Hourly">بالساعة</option> }<option value="Daily">يومي</option><option value="Weekly">أسبوعي</option><option value="Monthly">شهري</option><option value="Yearly">سنوي</option></select></label>
            <label>المدة<select value="@range" @onchange="ChangeRange"><option value="Day">آخر 24 ساعة</option><option value="Week">آخر 7 أيام</option><option value="Month">آخر 30 يومًا</option><option value="Quarter">آخر 90 يومًا</option><option value="HalfYear">آخر 6 أشهر</option><option value="Year">آخر 12 شهرًا</option><option value="ThreeYears">آخر 3 سنوات</option><option value="All">كل الفترة</option><option value="Custom">مدة مخصصة</option></select></label>
            <button class="chart-button" @onclick="Reset">إعادة الضبط</button>
        </div>
    </header>
    @if (range == ChartRange.Custom)
    {
        <div class="custom-range"><label>تاريخ البداية<input type="date" @bind="customFrom" /></label><label>تاريخ النهاية<input type="date" @bind="customTo" /></label><button class="report-action" @onclick="Load">تطبيق</button></div>
    }
    <div class="analytics-body">
        <aside class="chart-totals">
            @foreach (var item in Totals) { <div><span>@item.Label</span><strong>@item.Value</strong></div> }
        </aside>
        <div class="modern-chart-area">
            @if (loading) { <div class="chart-loading"><i></i>جارٍ تحديث البيانات...</div> }
            else if (result.Points.Count == 0) { <div class="report-empty">لا توجد بيانات ضمن الفترة المحددة</div> }
            else if (Tab == "visits")
            {
                <svg class="analytics-svg" viewBox="0 0 1000 360" role="img" aria-label="رسم عدد الزائرين">
                    @foreach (var tick in Ticks(MaxValue)) { <line x1="58" x2="982" y1="@tick.Y" y2="@tick.Y"><title>@Compact(tick.Value)</title></line> }
                    <polygon points="@AreaPoints" class="visit-fill" /><polyline points="@LinePoints" class="visit-line" />
                    @for (var i = 0; i < result.Points.Count; i++) { <circle cx="@X(i)" cy="@Y(result.Points[i].Visits)" r="5"><title>@result.Points[i].FullLabel — @result.Points[i].Visits.ToString("N0") زيارة</title></circle> }
                </svg>
                <div class="line-axis-labels">@foreach (var item in Labels) { <span>@item.Point.Label</span> }</div>
            }
            else
            {
                <div class="modern-bars">
                    @foreach (var point in result.Points)
                    {
                        var first = Tab == "sales" ? (double)point.Sales : point.Orders;
                        var second = Tab == "count" ? point.Products : 0;
                        <div class="modern-bar-group"><div class="modern-bar-stack"><span class="value-label">@(first > 0 ? ValueLabel(first) : "")</span><span class="modern-bar primary" style="height:@Height(first)%"><span class="chart-tooltip">@point.FullLabel<br />@(Tab == "sales" ? $"إجمالي المبيعات: ₪{point.Sales:N2}" : $"الطلبيات: {point.Orders:N0}")<br />@(Tab == "count" ? $"المنتجات المباعة: {point.Products:N0}" : "")</span></span>@if (Tab == "count") { <span class="value-label">@(second > 0 ? Compact(second) : "")</span><span class="modern-bar secondary" style="height:@Height(second)%"></span> }</div><small>@point.Label</small></div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public string Tab { get; set; } = "count";
    private enum ChartRange { Day, Week, Month, Quarter, HalfYear, Year, ThreeYears, All, Custom }
    private ReportPeriod period = ReportPeriod.Daily;
    private ChartRange range = ChartRange.Month;
    private DateTime? customFrom = DateTime.Today.AddDays(-29), customTo = DateTime.Today;
    private ReportResult result = new([], 0, 0, 0, 0);
    private bool loading;
    private CancellationTokenSource? loadCancellation;
    private string Title => Tab switch { "sales" => "إجمالي قيمة المبيعات", "visits" => "عدد الزائرين", _ => "عدد المبيعات" };
    private string Description => Tab switch { "sales" => "قيمة المبيعات النهائية للطلبات غير الملغاة", "visits" => "عدد زيارات الصفحة الرئيسية", _ => "مقارنة عدد الطلبيات بعدد المنتجات المباعة" };
    private IEnumerable<(string Label, string Value)> Totals => Tab switch { "sales" => [("إجمالي قيمة المبيعات", $"₪{result.Sales:N2}"), ("متوسط قيمة الطلب", $"₪{(result.Orders == 0 ? 0 : result.Sales / result.Orders):N2}")], "visits" => [("إجمالي الزيارات", result.Visits.ToString("N0")), (AverageTitle, (result.Points.Count == 0 ? 0 : result.Visits / (double)result.Points.Count).ToString("N1"))], _ => [("إجمالي الطلبات", result.Orders.ToString("N0")), ("إجمالي المنتجات المباعة", result.Products.ToString("N0"))] };
    private string AverageTitle => period switch { ReportPeriod.Hourly => "متوسط الزيارات في الساعة", ReportPeriod.Daily => "متوسط الزيارات يوميًا", ReportPeriod.Weekly => "متوسط الزيارات أسبوعيًا", ReportPeriod.Monthly => "متوسط الزيارات شهريًا", _ => "متوسط الزيارات سنويًا" };
    private double MaxValue => Math.Max(1, result.Points.Max(x => x.Visits));
    private double MaxBar => Math.Max(1, result.Points.Select(x => Tab == "sales" ? (double)x.Sales : Math.Max(x.Orders, x.Products)).DefaultIfEmpty(1).Max());
    private double Height(double value) => Math.Max(value > 0 ? 2 : 0, value / MaxBar * 88);
    private double X(int i) => result.Points.Count == 1 ? 520 : 70 + i * 900d / (result.Points.Count - 1);
    private double Y(double value) => 315 - value / MaxValue * 260;
    private string LinePoints => string.Join(" ", result.Points.Select((x, i) => $"{X(i):0.#},{Y(x.Visits):0.#}"));
    private string AreaPoints => $"70,315 {LinePoints} {(result.Points.Count == 1 ? 520 : X(result.Points.Count - 1)):0.#},315";
    private IEnumerable<(int Index, ReportPoint Point)> Labels { get { var step = Math.Max(1, (int)Math.Ceiling(result.Points.Count / 7d)); return result.Points.Select((p, i) => (i, p)).Where(x => x.i % step == 0 || x.i == result.Points.Count - 1); } }
    protected override async Task OnParametersSetAsync() { if (Tab == "visits" && period != ReportPeriod.Hourly) { period = ReportPeriod.Hourly; range = ChartRange.Day; } await Load(); }
    private async Task ChangePeriod(ChangeEventArgs e) { if (Enum.TryParse<ReportPeriod>(e.Value?.ToString(), out var p)) period = p; await Load(); }
    private async Task ChangeRange(ChangeEventArgs e) { if (Enum.TryParse<ChartRange>(e.Value?.ToString(), out var r)) range = r; MakeCompatible(); if (range != ChartRange.Custom) await Load(); }
    private async Task Reset() { period = Tab == "visits" ? ReportPeriod.Hourly : ReportPeriod.Daily; range = Tab == "visits" ? ChartRange.Day : ChartRange.Month; await Load(); }
    private void MakeCompatible() { period = range switch { ChartRange.Day => Tab == "visits" ? ReportPeriod.Hourly : ReportPeriod.Daily, ChartRange.Week or ChartRange.Month or ChartRange.Quarter when period is ReportPeriod.Monthly or ReportPeriod.Yearly => ReportPeriod.Daily, ChartRange.HalfYear or ChartRange.Year when period == ReportPeriod.Yearly => ReportPeriod.Monthly, ChartRange.ThreeYears when period is ReportPeriod.Hourly or ReportPeriod.Daily => ReportPeriod.Monthly, _ => period }; }
    private (DateTime From, DateTime To) Dates() { var end = DateTime.Today.AddDays(1); return range switch { ChartRange.Day => (DateTime.Now.AddHours(-24), DateTime.Now), ChartRange.Week => (end.AddDays(-7), end), ChartRange.Month => (end.AddDays(-30), end), ChartRange.Quarter => (end.AddDays(-90), end), ChartRange.HalfYear => (end.AddMonths(-6), end), ChartRange.Year => (end.AddYears(-1), end), ChartRange.ThreeYears => (end.AddYears(-3), end), ChartRange.All => (new DateTime(2000, 1, 1), end), _ => (customFrom?.Date ?? end.AddDays(-30), (customTo?.Date ?? DateTime.Today).AddDays(1)) }; }
    private async Task Load() { loadCancellation?.Cancel(); loadCancellation?.Dispose(); var request = new CancellationTokenSource(); loadCancellation = request; loading = true; try { var dates = Dates(); result = await ReportsService.GetReportAsync(period, dates.From, dates.To, Tab == "visits", request.Token); } catch (OperationCanceledException) { } finally { if (!request.IsCancellationRequested) loading = false; } }
    private static IEnumerable<(double Value, double Y)> Ticks(double max) => Enumerable.Range(0, 5).Select(i => (max * i / 4, 315 - i * 65d));
    private string ValueLabel(double value) => Tab == "sales" ? $"₪{Compact(value)}" : Compact(value);
    private static string Compact(double value) => Math.Abs(value) >= 1_000_000 ? $"{value / 1_000_000:0.#}M" : Math.Abs(value) >= 1_000 ? $"{value / 1_000:0.#}K" : $"{value:0.#}";
}
