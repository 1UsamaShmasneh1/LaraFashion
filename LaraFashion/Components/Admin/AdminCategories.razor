@page "/admin/categories"

@using LaraFashion.Models
@using LaraFashion.Services

@inject CategoryService CategoryService
@inject AdminAuthService AdminAuthService
@inject BrowserStorageService BrowserStorageService
@inject NavigationManager Navigation

<AdminNav />

<PageTitle>Categories</PageTitle>

@if (IsCheckingAuth)
{
    <div class="empty-cart">Checking admin access...</div>
    return;
}

<button class="logout-button" @onclick="Logout">Logout</button>

<h1 class="admin-page-title">إدارة التصنيفات</h1>

<button class="checkout-button admin-add-product-button" @onclick="OpenAddModal">
    إضافة تصنيف
</button>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="checkout-error">@ErrorMessage</div>
}

@if (Categories.Count == 0)
{
    <div class="empty-cart">لا توجد تصنيفات بعد</div>
}
else
{
    <div class="category-admin-grid">
        @foreach (var category in Categories)
        {
            <div class="category-admin-card">
                <div>
                    <h3>@category.Name</h3>
                    <span class="category-status @(category.IsActive ? "active" : "inactive")">
                        @(category.IsActive ? "فعال" : "غير فعال")
                    </span>
                </div>

                <div class="admin-product-actions">
                    <button class="continue-shopping-button" @onclick="() => OpenEditModal(category)">
                        تعديل
                    </button>
                    <button class="remove-item-button" @onclick="() => DeleteCategory(category.Id)">
                        حذف
                    </button>
                </div>
            </div>
        }
    </div>
}

@if (IsModalOpen)
{
    <div class="modal-overlay">
        <div class="checkout-modal" @onclick:stopPropagation="true">
            <h2>@(IsEditMode ? "تعديل تصنيف" : "إضافة تصنيف")</h2>

            <div class="form-group">
                <label>اسم التصنيف</label>
                <input @bind="CurrentCategory.Name" />
            </div>

            <label class="discount-check-row">
                <input type="checkbox" @bind="CurrentCategory.IsActive" />
                <span>التصنيف فعال</span>
            </label>

            <div class="checkout-buttons">
                <button type="button" class="continue-shopping-button" @onclick="CloseModal">
                    إلغاء
                </button>

                <button type="button" class="checkout-button" @onclick="SaveCategory">
                    حفظ
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool IsCheckingAuth = true;
    private bool IsModalOpen;
    private bool IsEditMode;
    private string ErrorMessage = string.Empty;

    private List<Category> Categories = new();
    private Category CurrentCategory = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var token = await BrowserStorageService.GetItemAsync("admin_token");

        if (string.IsNullOrWhiteSpace(token) || !AdminAuthService.IsTokenValid(token))
        {
            Navigation.NavigateTo("/admin/login");
            return;
        }

        IsCheckingAuth = false;
        await LoadCategories();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadCategories()
    {
        Categories = await CategoryService.GetAllAsync();
    }

    private void OpenAddModal()
    {
        ErrorMessage = string.Empty;
        IsEditMode = false;
        CurrentCategory = new Category { IsActive = true };
        IsModalOpen = true;
    }

    private void OpenEditModal(Category category)
    {
        ErrorMessage = string.Empty;
        IsEditMode = true;
        CurrentCategory = new Category
        {
            Id = category.Id,
            Name = category.Name,
            IsActive = category.IsActive
        };
        IsModalOpen = true;
    }

    private void CloseModal()
    {
        IsModalOpen = false;
        IsEditMode = false;
        CurrentCategory = new Category();
    }

    private async Task SaveCategory()
    {
        try
        {
            ErrorMessage = string.Empty;

            if (IsEditMode)
                await CategoryService.UpdateAsync(CurrentCategory);
            else
                await CategoryService.AddAsync(CurrentCategory);

            CloseModal();
            await LoadCategories();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private async Task DeleteCategory(Guid id)
    {
        await CategoryService.DeleteAsync(id);
        await LoadCategories();
    }

    private async Task Logout()
    {
        await BrowserStorageService.RemoveItemAsync("admin_token");
        Navigation.NavigateTo("/admin/login");
    }
}
