@using LaraFashion.Models

@if (IsOpen)
{
    <div class="modal-overlay">
        <div class="checkout-modal">

            @if (!IsContentReady)
            {
                <div class="modal-white-loader">
                    <div class="small-loader"></div>
                </div>
            }

            <div class="modal-content-wrapper @(IsContentReady ? "modal-content-visible" : "modal-content-hidden")">
            
                <h2>تأكيد الطلب</h2>

                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="checkout-error">
                        @ErrorMessage
                    </div>
                }

                <div class="form-group">
                    <label>الاسم الكامل *</label>
                    <input @bind="Customer.FullName" />
                </div>

                <div class="form-group">
                    <label>رقم الهاتف *</label>
                    <input @bind="Customer.PhoneNumber" />
                </div>

                <div class="form-group">
                    <label>العنوان *</label>
                    <input @bind="Customer.City" />
                </div>

                <div class="form-group">
                    <label>الشارع</label>
                    <input @bind="Customer.Street" />
                </div>

                <div class="form-group">
                    <label>رقم البيت</label>
                    <input @bind="Customer.HouseNumber" />
                </div>

                <div class="delivery-note-box">
                    <strong>موافقه</strong>

                    <div>
                        التوصيل متاح لجميع مناطق الضفة والداخل:
                    </div>

                    <div>الضفة: 25 شيقل.</div>
                    <div>الداخل: 50 شيقل.</div>
                    <div>القدس: 30 شيقل.</div>
                    <div>التخفيضات التي تشمل التوصيل لا تلزم بدفع اجر توصيل.</div>

                    <label class="confirmation-check">
                        <input type="checkbox" @bind="IsDeliveryConfirmed" />
                        أوافق بعد قراءة الملاحظة
                    </label>
                </div>

                <div class="checkout-buttons">
                    <button class="continue-shopping-button"
                            @onclick="BackToCart">
                        الرجوع للسلة
                    </button>

                    <button class="checkout-button"
                            @onclick="ConfirmOrder">
                        ارسال الطلب
                    </button>
                </div>

            </div>

        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<CustomerInfo> OnConfirm { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private CustomerInfo Customer { get; set; } = new();
    private bool IsDeliveryConfirmed;
    private string ErrorMessage = string.Empty;

    private bool IsContentReady;
    private bool WasOpen;

    private async Task ConfirmOrder()
    {
        ErrorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(Customer.FullName) ||
            string.IsNullOrWhiteSpace(Customer.PhoneNumber) ||
            string.IsNullOrWhiteSpace(Customer.City))
        {
            ErrorMessage = "الاسم الكامل ورقم الهاتف والعنوان يجب ملئها جميعاً.";
            return;
        }

        if (!IsDeliveryConfirmed)
        {
            ErrorMessage = "يجب الموافقه على الملاحضة.";
            return;
        }

        await OnConfirm.InvokeAsync(Customer);
    }

    private async Task BackToCart()
    {
        await OnClose.InvokeAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !WasOpen)
        {
            IsContentReady = false;
            WasOpen = true;

            await Task.Delay(120);

            IsContentReady = true;
        }

        if (!IsOpen)
        {
            WasOpen = false;
            IsContentReady = false;
        }
    }
}