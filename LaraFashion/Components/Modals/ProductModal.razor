@using LaraFashion.Models
@using LaraFashion.Models.Enums
@inject LaraFashion.Services.CartService CartService

@if (IsOpen)
{
    <div class="modal-overlay">
        <div class="product-modal">
            <button class="close-button" @onclick="CloseModal">X</button>

            @if (!IsContentReady)
            {
                <div class="modal-white-loader">
                    <div class="small-loader"></div>
                </div>
            }

            <div class="modal-content-wrapper @(IsContentReady ? "modal-content-visible" : "modal-content-hidden")">
                <div class="modal-grid">
                    <div>
                        @if (!string.IsNullOrWhiteSpace(Product.ImageUrl))
                        {
                            <img src="@Product.ImageUrl"
                                 class="modal-product-image"
                                 @onload="MarkContentReady"
                                 @onerror="MarkContentReady" />
                        }
                        else
                        {
                            <div class="product-image-placeholder modal-product-image">لا توجد صورة</div>
                        }
                    </div>

                    <div>
                        <h2>@Product.Name</h2>

                        @if (Product.ProductCategories.Any(x => x.Category.IsActive))
                        {
                            <div class="product-category-list modal-category-list">
                                @foreach (var pc in Product.ProductCategories.Where(x => x.Category.IsActive))
                                {
                                    <span class="product-category-badge">@pc.Category.Name</span>
                                }
                            </div>
                        }

                        <div class="product-price-container modal-price-container">
                            @if (Product.ShouldShowOldStorePrice)
                            {
                                <div class="old-price">₪@Product.StoreOriginalPrice</div>
                            }
                            <div class="modal-price">₪@Product.StorePrice</div>
                        </div>

                        @if (Product.ProductDiscounts.Any(x => x.Discount.IsActive && x.Discount.RuleType != DiscountRuleType.FixedSalePrice))
                        {
                            <div class="product-discounts-box">
                                <div class="product-discounts-title">العروض المتاحة</div>

                                @foreach (var productDiscount in Product.ProductDiscounts.Where(x => x.Discount.IsActive && x.Discount.RuleType != DiscountRuleType.FixedSalePrice))
                                {
                                    <div class="product-discount-row">
                                        🔥 @GetDiscountText(productDiscount.Discount)
                                    </div>
                                }
                            </div>
                        }

                        <div class="sizes-title">اختر المقاس</div>

                        <div class="sizes-container">
                            @foreach (var size in Product.Sizes)
                            {
                                var isOutOfStock = size.Quantity <= 0;

                                <button class="size-button @(SelectedSize == size.SizeName ? "selected-size" : "") @(isOutOfStock ? "out-of-stock-size" : "")"
                                        disabled="@isOutOfStock"
                                        @onclick="(() => SelectSize(size.SizeName))">
                                    @size.SizeName
                                </button>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(SelectedSize))
                        {
                            <div class="available-quantity @(SelectedSizeQuantity <= 0 ? "stock-out" : "stock-available")">
                                @(SelectedSizeQuantity <= 0 ? "غير متوفر" : $"الكمية المتاحة: {SelectedSizeQuantity}")
                            </div>

                            <div class="quantity-container">
                                <button class="quantity-button" @onclick="DecreaseQuantity">-</button>
                                <span class="quantity-value">@Quantity</span>
                                <button class="quantity-button" disabled="@(Quantity >= SelectedSizeQuantity)" @onclick="IncreaseQuantity">+</button>
                            </div>
                        }

                        <div class="modal-total">المجموع: ₪@(Quantity * Product.StorePrice)</div>

                        <div class="modal-buttons">
                            <button class="cancel-button" @onclick="CloseModal">Cancel</button>
                            <button class="add-to-cart-button" disabled="@(string.IsNullOrWhiteSpace(SelectedSize) || SelectedSizeQuantity <= 0)" @onclick="AddToCart">
                                Add To Cart
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public Product Product { get; set; } = new();

    [Parameter]
    public EventCallback OnClose { get; set; }

    private string SelectedSize = string.Empty;
    private int Quantity = 1;
    private int SelectedSizeQuantity;
    private bool IsContentReady;
    private Guid LastProductId;

    private void SelectSize(string size)
    {
        SelectedSize = size;
        SelectedSizeQuantity = Product.Sizes.FirstOrDefault(x => x.SizeName == size)?.Quantity ?? 0;

        var quantityAlreadyInCart = CartService.GetQuantity(Product.Id, size);

        Quantity = quantityAlreadyInCart > 0
            ? Math.Min(quantityAlreadyInCart, SelectedSizeQuantity)
            : 1;
    }

    private void IncreaseQuantity()
    {
        if (Quantity < SelectedSizeQuantity)
            Quantity++;
    }

    private void DecreaseQuantity()
    {
        if (Quantity > 1)
            Quantity--;
    }

    private async Task CloseModal()
    {
        await OnClose.InvokeAsync();
    }

    private async Task AddToCart()
    {
        if (string.IsNullOrWhiteSpace(SelectedSize) || SelectedSizeQuantity <= 0)
            return;

        CartService.AddToCart(Product, SelectedSize, Quantity);
        await CloseModal();
    }

    private string GetDiscountText(Discount discount)
    {
        return discount.RuleType switch
        {
            DiscountRuleType.ProductDirect =>
                discount.ValueType == DiscountValueType.Percent
                    ? $"خصم مباشر {discount.Value}%"
                    : $"خصم مباشر ₪{discount.Value}",

            DiscountRuleType.QuantityBased =>
                discount.ValueType == DiscountValueType.Percent
                    ? $"اشترِ {discount.MinimumQuantity} قطع أو أكثر واحصل على خصم {discount.Value}%"
                    : $"اشترِ {discount.MinimumQuantity} قطع أو أكثر واحصل على خصم ₪{discount.Value}",

            DiscountRuleType.AmountBased =>
                discount.ValueType == DiscountValueType.Percent
                    ? $"عند الشراء بقيمة ₪{discount.MinimumAmount} أو أكثر احصل على خصم {discount.Value}%"
                    : $"عند الشراء بقيمة ₪{discount.MinimumAmount} أو أكثر احصل على خصم ₪{discount.Value}",

            DiscountRuleType.BundleFixedPrice =>
                $"اشترِ {discount.MinimumQuantity} قطع من هذه المجموعة بسعر ₪{discount.BundleFixedTotalPrice} — يتم حساب التخفيض في السلة",

            DiscountRuleType.FixedSalePrice => string.Empty,

            _ => discount.Name
        };
    }

    protected override void OnParametersSet()
    {
        if (IsOpen && LastProductId != Product.Id)
        {
            LastProductId = Product.Id;
            SelectedSize = string.Empty;
            SelectedSizeQuantity = 0;
            Quantity = 1;
            IsContentReady = string.IsNullOrWhiteSpace(Product.ImageUrl);
        }

        if (!IsOpen)
        {
            IsContentReady = false;
            LastProductId = Guid.Empty;
            SelectedSize = string.Empty;
            SelectedSizeQuantity = 0;
            Quantity = 1;
        }
    }

    private void MarkContentReady()
    {
        IsContentReady = true;
    }
}
