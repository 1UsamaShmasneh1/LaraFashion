@using LaraFashion.Models
@using LaraFashion.Models.Enums
@inject LaraFashion.Services.CartService CartService

@if (IsOpen)
{
    <div class="modal-overlay">
        <div class="product-modal">
            <button class="close-button" @onclick="CloseModal">X</button>

            @if (!IsContentReady)
            {
                <div class="modal-white-loader">
                    <div class="small-loader"></div>
                </div>
            }

            <div class="modal-content-wrapper @(IsContentReady ? "modal-content-visible" : "modal-content-hidden")">
                <div class="modal-grid">
                    <div class="modal-product-gallery">
                        @if (!string.IsNullOrWhiteSpace(CurrentImageUrl))
                        {
                            <div class="modal-gallery-main">
                                <img @key="CurrentImageUrl"
                                     src="@CurrentImageUrl"
                                     class="modal-product-image"
                                     @onload="MarkContentReady"
                                     @onerror="MarkContentReady" />

                                @if (GalleryImageUrls.Count > 1)
                                {
                                    <button type="button" class="modal-gallery-nav modal-gallery-previous"
                                            aria-label="الصورة السابقة" @onclick="ShowPreviousImage">‹</button>
                                    <button type="button" class="modal-gallery-nav modal-gallery-next"
                                            aria-label="الصورة التالية" @onclick="ShowNextImage">›</button>
                                }
                            </div>

                            @if (GalleryImageUrls.Count > 1)
                            {
                                <div class="modal-gallery-thumbnails" dir="rtl">
                                    @for (var index = 0; index < GalleryImageUrls.Count; index++)
                                    {
                                        var imageIndex = index;
                                        var imageUrl = GalleryImageUrls[index];
                                        <button type="button"
                                                class="modal-gallery-thumbnail @(imageIndex == SelectedImageIndex ? "selected" : string.Empty)"
                                                aria-label="عرض الصورة @(imageIndex + 1)"
                                                @onclick="(() => SelectImage(imageIndex))">
                                            <img src="@imageUrl" alt="" loading="lazy" />
                                        </button>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="product-image-placeholder modal-product-image">لا توجد صورة</div>
                        }
                    </div>

                    <div>
                        <h2>@Product.Name</h2>

                        @if (Product.ProductCategories.Any(x => x.Category.IsActive))
                        {
                            <div class="product-category-list modal-category-list">
                                @foreach (var pc in Product.ProductCategories.Where(x => x.Category.IsActive))
                                {
                                    <span class="product-category-badge">@pc.Category.Name</span>
                                }
                            </div>
                        }

                        <div class="product-price-container modal-price-container">
                            @if (Product.ShouldShowOldStorePrice)
                            {
                                <div class="old-price">₪@Product.StoreOriginalPrice</div>
                            }
                            <div class="modal-price">₪@Product.StorePrice</div>
                        </div>

                        @if (Product.ProductDiscounts.Any(x => x.Discount.IsActive && x.Discount.RuleType != DiscountRuleType.FixedSalePrice))
                        {
                            <div class="product-discounts-box">
                                <div class="product-discounts-title">العروض المتاحة</div>

                                @foreach (var productDiscount in Product.ProductDiscounts.Where(x => x.Discount.IsActive && x.Discount.RuleType != DiscountRuleType.FixedSalePrice))
                                {
                                    <div class="product-discount-row">
                                        🔥 @GetDiscountText(productDiscount.Discount)
                                    </div>
                                }
                            </div>
                        }

                        <div class="sizes-title">اختر المقاس</div>

                        <div class="sizes-container">
                            @foreach (var size in Product.Sizes)
                            {
                                var isOutOfStock = size.Quantity <= 0;

                                <button class="size-button @(SelectedSize == size.SizeName ? "selected-size" : "") @(isOutOfStock ? "out-of-stock-size" : "")"
                                        disabled="@isOutOfStock"
                                        @onclick="(() => SelectSize(size.SizeName))">
                                    @size.SizeName
                                </button>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(SelectedSize))
                        {
                            <div class="available-quantity @(SelectedSizeQuantity <= 0 ? "stock-out" : "stock-available")">
                                @(SelectedSizeQuantity <= 0 ? "غير متوفر" : $"الكمية المتاحة: {SelectedSizeQuantity}")
                            </div>

                            <div class="quantity-container">
                                <button class="quantity-button" @onclick="DecreaseQuantity">-</button>
                                <span class="quantity-value">@Quantity</span>
                                <button class="quantity-button" disabled="@(Quantity >= SelectedSizeQuantity)" @onclick="IncreaseQuantity">+</button>
                            </div>
                        }

                        <div class="modal-total">المجموع: ₪@(Quantity * Product.StorePrice)</div>

                        <div class="modal-buttons">
                            <button class="cancel-button" @onclick="CloseModal">Cancel</button>
                            <button class="add-to-cart-button" disabled="@(string.IsNullOrWhiteSpace(SelectedSize) || SelectedSizeQuantity <= 0)" @onclick="AddToCart">
                                @AddToCartButtonText
                            </button>
                        </div>

                        @if (ShowUnpublishedNotice)
                        {
                            <div class="delivery-price-note" dir="rtl">
                                المنتج غير منشور حالياً.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .modal-product-gallery {
        min-width: 0;
        max-width: 100%;
    }

    .modal-gallery-main {
        position: relative;
        min-width: 0;
    }

    .modal-gallery-nav {
        position: absolute;
        top: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 46px;
        height: 46px;
        border: 0;
        border-radius: 50%;
        background: rgba(255, 255, 255, .92);
        color: #334155;
        box-shadow: 0 5px 16px rgba(15, 23, 42, .2);
        font-size: 32px;
        line-height: 1;
        cursor: pointer;
        transform: translateY(-50%);
    }

    .modal-gallery-previous {
        left: 10px;
    }

    .modal-gallery-next {
        right: 10px;
    }

    .modal-gallery-thumbnails {
        display: flex;
        gap: 9px;
        max-width: 100%;
        margin-top: 10px;
        padding: 3px 2px 7px;
        overflow-x: auto;
        overscroll-behavior-inline: contain;
    }

    .modal-gallery-thumbnail {
        flex: 0 0 72px;
        width: 72px;
        height: 72px;
        border: 2px solid transparent;
        border-radius: 12px;
        padding: 3px;
        background: #f7f7f7;
        cursor: pointer;
    }

    .modal-gallery-thumbnail.selected {
        border-color: #7c3aed;
    }

    .modal-gallery-thumbnail > img {
        display: block;
        width: 100%;
        height: 100%;
        border-radius: 8px;
        object-fit: contain;
    }

    @@media (max-width: 700px) {
        .modal-gallery-nav {
            width: 44px;
            height: 44px;
        }

        .modal-gallery-thumbnail {
            flex-basis: 64px;
            width: 64px;
            height: 64px;
        }
    }
</style>

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public Product Product { get; set; } = new();

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public bool AllowUnpublishedAdd { get; set; }

    [Parameter]
    public bool ShowUnpublishedNotice { get; set; }

    [Parameter]
    public string AddToCartButtonText { get; set; } = "Add To Cart";

    private string SelectedSize = string.Empty;
    private int Quantity = 1;
    private int SelectedSizeQuantity;
    private bool IsContentReady;
    private Guid LastProductId;
    private List<string> GalleryImageUrls = new();
    private int SelectedImageIndex;
    private string CurrentImageUrl => SelectedImageIndex >= 0 && SelectedImageIndex < GalleryImageUrls.Count
        ? GalleryImageUrls[SelectedImageIndex]
        : string.Empty;

    private void SelectSize(string size)
    {
        SelectedSize = size;
        SelectedSizeQuantity = Product.Sizes.FirstOrDefault(x => x.SizeName == size)?.Quantity ?? 0;

        var quantityAlreadyInCart = CartService.GetQuantity(Product.Id, size);

        Quantity = quantityAlreadyInCart > 0
            ? Math.Min(quantityAlreadyInCart, SelectedSizeQuantity)
            : 1;
    }

    private void IncreaseQuantity()
    {
        if (Quantity < SelectedSizeQuantity)
            Quantity++;
    }

    private void DecreaseQuantity()
    {
        if (Quantity > 1)
            Quantity--;
    }

    private async Task CloseModal()
    {
        await OnClose.InvokeAsync();
    }

    private async Task AddToCart()
    {
        if (string.IsNullOrWhiteSpace(SelectedSize) || SelectedSizeQuantity <= 0)
            return;

        CartService.AddToCart(Product, SelectedSize, Quantity, AllowUnpublishedAdd);
        await CloseModal();
    }

    private string GetDiscountText(Discount discount)
    {
        return discount.RuleType switch
        {
            DiscountRuleType.ProductDirect =>
                discount.ValueType == DiscountValueType.Percent
                    ? $"خصم مباشر {discount.Value}%"
                    : $"خصم مباشر ₪{discount.Value}",

            DiscountRuleType.QuantityBased =>
                discount.ValueType == DiscountValueType.Percent
                    ? $"اشترِ {discount.MinimumQuantity} قطع أو أكثر واحصل على خصم {discount.Value}%"
                    : $"اشترِ {discount.MinimumQuantity} قطع أو أكثر واحصل على خصم ₪{discount.Value}",

            DiscountRuleType.AmountBased =>
                discount.ValueType == DiscountValueType.Percent
                    ? $"عند الشراء بقيمة ₪{discount.MinimumAmount} أو أكثر احصل على خصم {discount.Value}%"
                    : $"عند الشراء بقيمة ₪{discount.MinimumAmount} أو أكثر احصل على خصم ₪{discount.Value}",

            DiscountRuleType.BundleFixedPrice =>
                $"اشترِ {discount.MinimumQuantity} قطع من هذه المجموعة بسعر ₪{discount.BundleFixedTotalPrice} — يتم حساب التخفيض في السلة",

            DiscountRuleType.FixedSalePrice => string.Empty,

            _ => discount.Name
        };
    }

    private void SelectImage(int index)
    {
        if (index >= 0 && index < GalleryImageUrls.Count)
            SelectedImageIndex = index;
    }

    private void ShowPreviousImage()
    {
        if (GalleryImageUrls.Count > 1)
            SelectedImageIndex = (SelectedImageIndex - 1 + GalleryImageUrls.Count) % GalleryImageUrls.Count;
    }

    private void ShowNextImage()
    {
        if (GalleryImageUrls.Count > 1)
            SelectedImageIndex = (SelectedImageIndex + 1) % GalleryImageUrls.Count;
    }

    private void InitializeGallery()
    {
        GalleryImageUrls = Product.Images
            .Where(x => !string.IsNullOrWhiteSpace(x.ImageUrl))
            .OrderBy(x => x.SortOrder)
            .ThenBy(x => x.Id)
            .Select(x => x.ImageUrl)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (GalleryImageUrls.Count == 0 && !string.IsNullOrWhiteSpace(Product.ImageUrl))
            GalleryImageUrls.Add(Product.ImageUrl);

        var primaryImageUrl = Product.PrimaryImageUrl;
        var primaryIndex = GalleryImageUrls.FindIndex(x =>
            string.Equals(x, primaryImageUrl, StringComparison.OrdinalIgnoreCase));
        SelectedImageIndex = primaryIndex >= 0 ? primaryIndex : 0;
        IsContentReady = GalleryImageUrls.Count == 0;
    }

    protected override void OnParametersSet()
    {
        if (IsOpen && LastProductId != Product.Id)
        {
            LastProductId = Product.Id;
            SelectedSize = string.Empty;
            SelectedSizeQuantity = 0;
            Quantity = 1;
            InitializeGallery();
        }

        if (!IsOpen)
        {
            IsContentReady = false;
            LastProductId = Guid.Empty;
            SelectedSize = string.Empty;
            SelectedSizeQuantity = 0;
            Quantity = 1;
            GalleryImageUrls = new();
            SelectedImageIndex = 0;
        }
    }

    private void MarkContentReady()
    {
        IsContentReady = true;
    }
}
