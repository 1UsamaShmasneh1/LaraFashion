@using LaraFashion.Models
@using LaraFashion.Models.Enums
@inject LaraFashion.Services.CartService CartService

@if (IsOpen)
{
    <div class="modal-overlay">

        <div class="product-modal">

            <button class="close-button"
                    @onclick="CloseModal">

                X

            </button>

            <div class="modal-grid">

                <div>

                    <img src="@Product.ImageUrl"
                         class="modal-product-image" />

                </div>

                <div>

                    <h2>
                        @Product.Name
                    </h2>

                    <div class="modal-serial">
                        Serial: @Product.SerialNumber
                    </div>

                    <div class="modal-price">
                        ₪@Product.FinalPrice
                    </div>

                    @if (Product.ProductDiscounts.Any(x => x.Discount.IsActive))
                    {
                        <div class="product-discounts-box">
                            <div class="product-discounts-title">العروض المتاحة</div>

                            @foreach (var productDiscount in Product.ProductDiscounts.Where(x => x.Discount.IsActive))
                            {
                                <div class="product-discount-row">
                                    🔥 @GetDiscountText(productDiscount.Discount)
                                </div>
                            }
                        </div>
                    }

                    <div class="sizes-title">
                        Select Size
                    </div>

                    <div class="sizes-container">

                        @foreach (var size in Product.Sizes)
                        {
                            <button class="size-button @(SelectedSize == size.SizeName ? "selected-size" : "")"
                                    @onclick="(() => SelectSize(size.SizeName))">

                                @size.SizeName

                            </button>
                        }

                    </div>

                    @if (!string.IsNullOrWhiteSpace(SelectedSize))
                    {
                        <div class="available-quantity">

                            Available Quantity:
                            @SelectedSizeQuantity

                        </div>

                        <div class="quantity-container">

                            <button class="quantity-button"
                                    @onclick="DecreaseQuantity">

                                -

                            </button>

                            <span class="quantity-value">
                                @Quantity
                            </span>

                            <button class="quantity-button"
                                    @onclick="IncreaseQuantity">

                                +

                            </button>

                        </div>
                    }

                    <div class="modal-total">

                        Total:
                        ₪@(Quantity * Product.FinalPrice)

                    </div>

                    <div class="modal-buttons">

                        <button class="cancel-button"
                                @onclick="CloseModal">

                            Cancel

                        </button>

                        <button class="add-to-cart-button"
                                @onclick="AddToCart">

                            Add To Cart

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>
}

@code {

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public Product Product { get; set; } = new();

    [Parameter]
    public EventCallback OnClose { get; set; }

    private string SelectedSize = string.Empty;

    private int Quantity = 1;

    private int SelectedSizeQuantity;

    private void SelectSize(string size)
    {
        SelectedSize = size;

        SelectedSizeQuantity =
            Product.Sizes
                .FirstOrDefault(x => x.SizeName == size)?
                .Quantity ?? 0;

        Quantity = 1;
    }

    private void IncreaseQuantity()
    {
        if (Quantity < SelectedSizeQuantity)
        {
            Quantity++;
        }
    }

    private void DecreaseQuantity()
    {
        if (Quantity > 1)
        {
            Quantity--;
        }
    }

    private async Task CloseModal()
    {
        await OnClose.InvokeAsync();
    }

    private async Task AddToCart()
    {
        if (string.IsNullOrWhiteSpace(SelectedSize))
            return;

        CartService.AddToCart(
            Product,
            SelectedSize,
            Quantity);

        await CloseModal();
    }

    private string GetDiscountText(Discount discount)
    {
        return discount.RuleType switch
        {
            DiscountRuleType.ProductDirect =>
                discount.ValueType == DiscountValueType.Percent
                    ? $"خصم مباشر {discount.Value}%"
                    : $"خصم مباشر ₪{discount.Value}",

            DiscountRuleType.QuantityBased =>
                discount.ValueType == DiscountValueType.Percent
                    ? $"اشترِ {discount.MinimumQuantity} قطع أو أكثر واحصل على خصم {discount.Value}%"
                    : $"اشترِ {discount.MinimumQuantity} قطع أو أكثر واحصل على خصم ₪{discount.Value}",

            DiscountRuleType.AmountBased =>
                discount.ValueType == DiscountValueType.Percent
                    ? $"عند الشراء بقيمة ₪{discount.MinimumAmount} أو أكثر احصل على خصم {discount.Value}%"
                    : $"عند الشراء بقيمة ₪{discount.MinimumAmount} أو أكثر احصل على خصم ₪{discount.Value}",

            DiscountRuleType.BundleFixedPrice =>
    $"اشترِ {discount.MinimumQuantity} قطع من هذه المجموعة بسعر ₪{discount.BundleFixedTotalPrice} — يتم حساب التخفيض في السلة",

            _ => discount.Name
        };
    }

}